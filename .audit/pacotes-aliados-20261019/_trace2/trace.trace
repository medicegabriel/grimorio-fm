teca de Modelos"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-library w-4 h-4 shrink-0"},["path",{"d":"m16 6 4 14"}],["path",{"d":"M12 6v14"}],["path",{"d":"M8 8v12"}],["path",{"d":"M4 4v16"}]],["SPAN",{"class":"hidden lg:inline"},"Modelos"]],["BUTTON",{"type":"button","class":"inline-flex items-center justify-center gap-1.5 h-9 w-9 lg:w-auto lg:px-3 shrink-0 rounded bg-slate-800 hover:bg-slate-700 text-sm font-semibold text-slate-200 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500/60","title":"Importar"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-upload w-4 h-4 shrink-0"},["path",{"d":"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"}],["polyline",{"points":"17 8 12 3 7 8"}],["line",{"x1":"12","x2":"12","y1":"3","y2":"15"}]],["SPAN",{"class":"hidden lg:inline"},"Importar"]],["BUTTON",{"type":"button","class":"inline-flex items-center justify-center gap-1.5 h-9 w-9 lg:w-auto lg:px-3 shrink-0 rounded bg-slate-800 hover:bg-slate-700 text-sm font-semibold text-slate-200 transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-purple-500/60","title":"Exportar personagens da visualização atual"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-download w-4 h-4 shrink-0"},["path",{"d":"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"}],["polyline",{"points":"7 10 12 15 17 10"}],["line",{"x1":"12","x2":"12","y1":"15","y2":"3"}]],["SPAN",{"class":"hidden lg:inline"},"Exportar"]],["BUTTON",{"type":"button","class":"inline-flex items-center justify-center gap-1.5 h-9 w-9 lg:w-auto lg:px-4 shrink-0 rounded bg-purple-800 hover:bg-purple-700 text-sm font-bold text-white transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-purple-500","title":"Criar novo personagem"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-plus w-4 h-4 shrink-0"},["path",{"d":"M5 12h14"}],["path",{"d":"M12 5v14"}]],["SPAN",{"class":"hidden lg:inline"},"Novo Personagem"]]],["DIV",{"class":"w-full flex items-center gap-2 pt-1.5 border-t border-slate-800/60"},["SPAN",{"class":"text-[10px] text-slate-500 truncate min-w-0"},"Uso de Memória: ","32KB"," / ","10.0MB"],["DIV",{"class":"flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden min-w-0"},["DIV",{"class":"h-full rounded-full transition-all duration-500 bg-emerald-500","style":"width: 0.31105%;"}]],["SPAN",{"class":"text-[10px] tabular-nums text-slate-600 shrink-0"},"0","%"]]]],["DIV",{"class":"w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-6"},["DIV",{"class":"hidden lg:block"},["DIV",{"class":"sticky","style":"top: 209px;"},["ASIDE",{"class":"bg-slate-900/60 border border-slate-800 rounded-lg p-3 "},["UL",{"class":"space-y-1 mb-3"},["LI",{},["BUTTON",{"type":"button","class":"w-full flex items-center gap-2 px-3 py-2 rounded text-sm text-left transition-colors focus:outline-none focus:ring-1 focus:ring-purple-500/60 bg-purple-950/50 border border-purple-800/60 text-purple-100"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-library w-4 h-4 flex-shrink-0 text-purple-400"},["path",{"d":"m16 6 4 14"}],["path",{"d":"M12 6v14"}],["path",{"d":"M8 8v12"}],["path",{"d":"M4 4v16"}]],["SPAN",{"class":"flex-1 truncate font-semibold"},"Todas"],["SPAN",{"class":"text-[10px] tabular-nums text-purple-300"},"1"]]],["LI",{},["BUTTON",{"type":"button","class":"w-full flex items-center gap-2 px-3 py-2 rounded text-sm text-left transition-colors focus:outline-none focus:ring-1 focus:ring-purple-500/60 text-slate-300 hover:bg-slate-800/60 border border-transparent"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-inbox w-4 h-4 flex-shrink-0 text-slate-400"},["polyline",{"points":"22 12 16 12 14 15 10 15 8 12 2 12"}],["path",{"d":"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"}]],["SPAN",{"class":"flex-1 truncate font-semibold"},"Sem Pasta"],["SPAN",{"class":"text-[10px] tabular-nums text-slate-600"},"1"]]]],["DIV",{"class":"flex items-center justify-between px-2 mb-2"},["SPAN",{"class":"text-[10px] uppercase tracking-widest text-slate-500 font-bold"},"Pastas"],["BUTTON",{"type":"button","class":"inline-flex items-center gap-1 text-[10px] text-purple-400 hover:text-purple-300 uppercase tracking-wider font-bold focus:outline-none focus:ring-1 focus:ring-purple-500/40 rounded px-1","aria-label":"Nova pasta"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-folder-plus w-3 h-3"},["path",{"d":"M12 10v6"}],["path",{"d":"M9 13h6"}],["path",{"d":"M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"}]]," Nova"]],["DIV",{"class":"text-center py-4 px-2 text-[11px] text-slate-600 italic 