-100"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-library w-4 h-4 flex-shrink-0 text-purple-400"},["path",{"d":"m16 6 4 14"}],["path",{"d":"M12 6v14"}],["path",{"d":"M8 8v12"}],["path",{"d":"M4 4v16"}]],["SPAN",{"class":"flex-1 truncate font-semibold"},"Todas"],["SPAN",{"class":"text-[10px] tabular-nums text-purple-300"},"1"]]],["LI",{},["BUTTON",{"type":"button","class":"w-full flex items-center gap-2 px-3 py-2 rounded text-sm text-left transition-colors focus:outline-none focus:ring-1 focus:ring-purple-500/60 text-slate-300 hover:bg-slate-800/60 border border-transparent"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-inbox w-4 h-4 flex-shrink-0 text-slate-400"},["polyline",{"points":"22 12 16 12 14 15 10 15 8 12 2 12"}],["path",{"d":"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"}]],["SPAN",{"class":"flex-1 truncate font-semibold"},"Sem Pasta"],["SPAN",{"class":"text-[10px] tabular-nums text-slate-600"},"1"]]]],["DIV",{"class":"flex items-center justify-between px-2 mb-2"},["SPAN",{"class":"text-[10px] uppercase tracking-widest text-slate-500 font-bold"},"Pastas"],["BUTTON",{"type":"button","class":"inline-flex items-center gap-1 text-[10px] text-purple-400 hover:text-purple-300 uppercase tracking-wider font-bold focus:outline-none focus:ring-1 focus:ring-purple-500/40 rounded px-1","aria-label":"Nova pasta"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-folder-plus w-3 h-3