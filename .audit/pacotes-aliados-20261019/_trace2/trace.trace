{"type":"frame-snapshot","snapshot":{"callId":"call@1088","snapshotName":"after@call@1088","pageId":"page@8e040f92703f309068950c3ceea5df99","frameId":"frame@2330215820439487163da9a329f548dd","frameUrl":"http://127.0.0.1:5320/Player?ficha-g2=1","doctype":"html","html":["HTML",{"lang":"pt-BR","translate":"no"},["HEAD",{},[[5,0]],[[5,1]],[[5,2]],[[5,3]],[[5,4]],[[5,5]],[[5,6]],[[5,7]],[[5,8]],[[5,9]],[[5,10]],[[5,11]],[[5,12]],[[5,14]],[[5,15]],[[5,17]],[[5,19]],[[5,21]],[[5,23]],[[5,25]],[[5,27]],["STYLE",{},"/* ========== ESTUDO (estudo/estudo.css) ========== */\n/* ============================================================\n   ESTUDO DE HABILIDADES · linguagem visual\n   ============================================================\n   Das referências da rodada 5:\n   - Demiplane: placa de identidade com retrato em moldura, nome em letra\n     de painel (Bahnschrift semicondensada, do sistema), números grandes;\n     condições e efeitos colados aos recursos.\n   - Foundry dnd5e: o retrato como peça principal da identidade; grupos em\n     cartões com faixa de título.\n   - D&D Beyond: a linha com nome e uma segunda fileira que diz o que a\n     coisa faz.\n   Tipo: Bahnschrift para nome, títulos e números; Segoe UI no corpo; a\n   regra em 15,5 px com medida de leitura.\n   Cartão quando ajuda a ler: a placa (quem é), cada grupo (de onde vem),\n   a consulta (o que estou lendo).\n   ============================================================ */\n/* Papéis derivados, recalculados em cada superfície que um tema pode repintar. */\n.e-g2,\n.e-g2 :is(.afty-cabecalho, .afty-card, .afty-vital, .afty-stat, .e-consulta, .m-flutuante) {\n  --e-t1: var(--afty-texto);\n  --e-t2: var(--afty-texto-suave);\n  --e-t3: color-mix(in oklab, var(--afty-texto-suave) 70%, var(--afty-fundo));\n  --e-linha: color-mix(in oklab, var(--afty-texto) 9%, transparent);\n  --e-hover: color-mix(in oklab, var(--afty-texto) 4.5%, transparent);\n  --e-ctrl: color-mix(in oklab, var(--afty-texto) 7%, transparent);\n  --e-ctrl-hover: color-mix(in oklab, var(--afty-texto) 12%, transparent);\n  --e-ctrl-borda: color-mix(in oklab, var(--afty-texto) 16%, transparent);\n  --e-sel: color-mix(in oklab, var(--afty-destaque) 15%, transparent);\n  --e-sel-borda: color-mix(in oklab, var(--afty-destaque) 62%, transparent);\n  --e-ativo: var(--afty-destaque-texto);\n  /* Avisos operacionais (cobrança, bloqueio, PE que o controle não desconta):\n     a cor do tema, roxo neste estudo, pedida pelo autor em 2026-10-14. O âmbar\n     e o vermelho ficam para os RECURSOS (PV Temporário, Vida e o que muda neles). */\n  --e-aviso: var(--afty-destaque-texto);\n  --e-aviso-icone: var(--afty-destaque-texto);\n  --e-aviso-borda: color-mix(in oklab, var(--afty-destaque) 60%, transparent);\n  --e-aviso-fundo: color-mix(in oklab, var(--afty-destaque) 12%, transparent);\n  --e-painel: color-mix(in oklab, var(--afty-card) 82%, var(--afty-fundo));\n  --e-painel-borda: color-mix(in oklab, var(--afty-texto) 9%, transparent);\n  --e-flutuante: color-mix(in oklab, var(--afty-card) 94%, var(--afty-texto));\n  --e-display: \"Bahnschrift\", \"Segoe UI\", system-ui, sans-serif;\n  --e-num: tabular-nums lining-nums;\n}\n.e-g2 { color: var(--e-t1); font: 14px/1.45 var(--afty-fonte); }\n.e-g2 :focus-visible { outline: 2px solid var(--afty-destaque); outline-offset: 2px; border-radius: 6px; }\n.e-g2 svg { width: 16px; height: 16px; flex: none; }\n.e-g2 button { font: inherit; color: inherit; }\n.e-g2 button:disabled { cursor: default; }\n.e-display { font-family: var(--e-display); font-stretch: semi-condensed; }\n\n/* ---------------- placa: identidade, recursos, valores e Agora ---------------- */\n.e-g2 .e-cabeca {\n  position: relative; margin: 14px 18px 0; padding: 14px 18px 0 16px;\n  border: 1px solid var(--e-painel-borda); border-radius: 18px;\n  background:\n    radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--afty-destaque) 20%, transparent), transparent 55%),\n    color-mix(in oklab, var(--afty-card) 88%, var(--afty-fundo));\n  box-shadow: 0 16px 36px -24px rgb(0 0 0 / .9);\n}\n.e-g2 .e-placa { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; column-gap: 18px; padding-bottom: 12px; }\n.e-g2 .e-moldura { width: 80px; height: 80px; padding: 3px; border-radius: 50%; background: conic-gradient(from 210deg, var(--afty-destaque), var(--afty-destaque-texto), var(--afty-destaque)); box-shadow: 0 0 0 3px color-mix(in oklab, var(--afty-card) 90%, var(--afty-fundo)), 0 12px 24px -10px rgb(0 0 0 / .8); }\n.e-g2 .e-retrato { display: block; width: 74px; height: 74px; border-radius: 50%; object-fit: cover; }\n.e-g2 .m-retrato-vazio { display: inline-flex; align-items: center; justify-content: center; background: var(--e-ctrl-hover); color: var(--e-t2); font-weight: 700; }\n.e-g2 .e-ident { min-width: 0; }\n.e-g2 .e-nome { margin: 0; font: 600 28px/1.05 var(--e-display); font-stretch: semi-condensed; letter-spacing: .005em; }\n.e-g2 .e-linhagem { margin: 5px 0 0; display: flex; flex-wrap: wrap; font-size: 13.5px; color: var(--e-t2); }\n.e-g2 .e-linhagem span + span::before { content: \"·\"; margin: 0 7px; color: var(--e-t3); }\n.e-g2 .e-classe { color: var(--e-ativo); font-weight: 600; }\n.e-g2 .e-recursos { display: flex; gap: 10px; }\n.e-g2 .m-medidor { position: relative; width: 168px; display: grid; gap: 5px; padding: 6px 10px 8px; border: 1px solid transparent; border-radius: 10px; background: color-mix(in oklab, var(--afty-poco) 55%, transparent); color: var(--e-t1); text-align: left; }\n.e-g2 .m-medidor:hover { border-color: var(--e-ctrl-borda); }\n.e-g2 .m-medidor-topo { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; }\n.e-g2 .m-medidor-rotulo { margin-right: auto; font: 600 13px var(--e-display); font-stretch: semi-condensed; color: var(--e-t2); }\n.e-g2 .m-medidor-num { display: inline-flex; align-items: baseline; gap: 1px; font-family: var(--e-display); font-variant-numeric: var(--e-num); }\n.e-g2 .m-medidor-num b { font-size: 23px; font-weight: 700; line-height: 1; }\n.e-g2 .m-medidor-num .afty-vital-max { font-size: 14px; color: var(--e-t2); }\n.e-g2 .m-medidor-num em { margin-left: 5px; font-style: normal; font-size: 14px; font-weight: 700; color: var(--afty-pvtemp); }\n.e-g2 .m-medidor[data-recurso=\"pe\"] em { color: var(--afty-petemp); }\n.e-g2 .m-barra { position: relative; display: block; height: 6px; border-radius: 3px; overflow: hidden; background: color-mix(in oklab, var(--afty-texto) 12%, transparent); }\n.e-g2 .m-barra-cheia { position: absolute; inset: 0 auto 0 0; border-radius: inherit; }\n.e-g2 .m-barra[data-recurso=\"pv\"] .m-barra-cheia { background: var(--afty-pv); }\n.e-g2 .m-barra[data-recurso=\"pe\"] .m-barra-cheia { background: var(--afty-pe); }\n.e-g2 .m-barra[data-recurso=\"alma\"] .m-barra-cheia { background: var(--afty-alma); }\n.e-g2 .m-barra[data-recurso=\"preparo\"] .m-barra-cheia { background: var(--afty-destaque); }\n.e-g2 .m-barra .m-barra-temp { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: var(--afty-vital-cor); box-shadow: none; }\n.e-g2 .m-flash { position: absolute; right: 8px; top: -12px; padding: 0 6px; border-radius: 6px; background: var(--afty-fundo); font-style: normal; font-size: 13px; font-weight: 700; animation: e-sobe 2.4s ease-out forwards; }\n.e-g2 .m-flash[data-sinal=\"menos\"] { color: var(--afty-pv); }\n.e-g2 .m-flash[data-sinal=\"mais\"] { color: var(--afty-cura); }\n@keyframes e-sobe { from { opacity: 1; } to { opacity: 0; transform: translateY(-6px); } }\n.e-g2 .e-icone { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 9px; background: none; color: var(--e-t2); align-self: start; }\n.e-g2 .e-icone:hover { background: var(--e-ctrl); color: var(--e-t1); }\n\n.e-g2 .e-faixa { display: flex; align-items: center; gap: 18px; min-height: 48px; border-top: 1px solid var(--e-linha); }\n.e-g2 .e-stats { flex: 1; display: flex; align-items: baseline; gap: 16px; margin: 0; min-width: 0; overflow: hidden; }\n.e-g2 .e-mais { flex: none; height: 26px; padding: 0 8px; border: 0; border-radius: 7px; background: var(--e-ctrl); color: var(--e-t1); font-size: 13px; font-weight: 600; }\n.e-g2 .e-stats-mais { display: grid; gap: 8px; margin: 0; }\n.e-g2 .e-stats-mais .e-stat { justify-content: space-between; }\n.e-g2 .e-stat { display: inline-flex; align-items: baseline; gap: 6px; white-space: nowrap; }\n.e-g2 .e-stat dt { font-size: 12.5px; color: var(--e-t2); }\n.e-g2 .e-stat dd { margin: 0; }\n.e-g2 .e-stat .m-valor-botao, .e-g2 .e-stat .m-valor { font: 600 17px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .e-stat[data-efeito] .m-valor-botao { color: var(--e-ativo); }\n.e-g2 .e-stat[data-efeito] .m-valor-botao::before { content: \"◆ \"; font-size: 10px; vertical-align: 2px; color: var(--afty-destaque); }\n.e-g2 .m-valor { font-variant-numeric: var(--e-num); }\n.e-g2 .m-valor-botao { border: 0; background: none; padding: 0 1px; font-variant-numeric: var(--e-num); color: var(--e-t1); cursor: help; text-decoration: underline dotted transparent; text-underline-offset: 3px; }\n.e-g2 .m-valor-botao:hover { text-decoration-color: var(--e-t3); }\n\n.e-g2 .e-agora { flex: none; margin-left: auto; display: flex; align-items: center; gap: 8px; padding-left: 18px; border-left: 1px solid var(--e-linha); min-height: 48px; }\n.e-g2 .e-agora-rotulo { font: 600 13px var(--e-display); font-stretch: semi-condensed; color: var(--e-t2); margin-right: 2px; }\n.e-g2 .e-agora-vazio { font-size: 13px; color: var(--e-t3); }\n.e-g2 .e-combate { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border: 1px solid var(--e-ctrl-borda); border-radius: 8px; background: none; color: var(--e-t2); font-size: 13px; font-weight: 600; white-space: nowrap; }\n.e-g2 .e-combate svg { width: 14px; height: 14px; }\n.e-g2 .e-combate[aria-pressed=\"true\"] { color: var(--afty-cura); border-color: color-mix(in oklab, var(--afty-cura) 45%, transparent); background: color-mix(in oklab, var(--afty-cura) 10%, transparent); }\n.e-g2 .e-rodada { display: inline-flex; align-items: center; height: 30px; padding-left: 10px; border-radius: 8px; background: var(--e-ctrl); font-size: 13px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .e-rodada b { margin: 0 6px 0 5px; font: 700 15px var(--e-display); color: var(--e-t1); }\n.e-g2 .e-proxima { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border: 0; border-left: 1px solid var(--e-linha); border-radius: 0 8px 8px 0; background: none; color: var(--e-t1); }\n.e-g2 .e-proxima:hover { background: var(--e-ctrl-hover); }\n.e-g2 .e-cond { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 8px 0 10px; border-radius: 8px; border: 1px solid var(--e-aviso-borda); background: var(--e-aviso-fundo); color: var(--e-aviso); font-size: 13px; font-weight: 700; white-space: nowrap; }\n.e-g2 .e-cond b { min-width: 18px; height: 18px; padding: 0 4px; display: inline-flex; align-items: center; justify-content: center; border-radius: 5px; background: color-mix(in oklab, var(--afty-destaque) 25%, transparent); font-size: 12px; font-variant-numeric: var(--e-num); }\n.e-g2 .m-chip { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 9px; border: 1px solid var(--e-ctrl-borda); border-radius: 8px; background: none; color: var(--e-t2); font-size: 13px; white-space: nowrap; }\n.e-g2 .m-chip svg { width: 13px; height: 13px; }\n.e-g2 .m-chip[data-estado=\"ativo\"] { border-color: var(--e-sel-borda); background: var(--e-sel); color: var(--e-t1); }\n.e-g2 .m-chip[data-estado=\"ativo\"]::before { content: \"◆\"; font-size: 9px; color: var(--afty-destaque); }\n.e-g2 .m-chip-valor { font-weight: 700; color: var(--e-ativo); }\n\n/* ---------------- abas ---------------- */\n.e-g2 .e-abas { display: flex; gap: 2px; margin: 8px 0 0; border-bottom: 1px solid var(--e-linha); overflow-x: auto; scrollbar-width: none; }\n.e-g2 .e-aba { position: relative; height: 44px; padding: 0 14px; border: 0; background: none; color: var(--e-t2); font: 600 16px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .e-aba[aria-selected=\"true\"] { color: var(--e-t1); }\n.e-g2 .e-aba[aria-selected=\"true\"]::after { content: \"\"; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: var(--afty-destaque); }\n.e-g2 .e-aba[aria-disabled] { color: var(--e-t3); cursor: not-allowed; }\n\n/* ---------------- a área da aba e a lista ---------------- */\n/* A margem da direita é a trilha do botão dos Livros: nada da lista passa por baixo dele. */\n.e-g2 .e-area { position: relative; min-height: 0; margin: 0; display: flex; height: calc(100dvh - var(--afty-ficha-topo, 0px) - 8px); }\n.e-g2 .e-habilidades { flex: 1; min-width: 0; overflow: auto; padding: 0 0 28px; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .e-ferramentas { position: sticky; top: 0; z-index: 3; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px 16px; padding: 14px 0 12px; background: var(--afty-fundo); transition: box-shadow .15s; }\n.e-g2 .e-habilidades[data-rolada] .e-ferramentas { box-shadow: 0 1px 0 var(--e-linha), 0 14px 16px -14px rgb(0 0 0 / .9); }\n.e-g2 .e-busca { position: relative; display: flex; align-items: center; }\n.e-g2 .e-busca > svg { position: absolute; left: 14px; color: var(--e-t2); pointer-events: none; }\n.e-g2 .e-busca .afty-campo { flex: 1; height: 42px; padding: 0 40px 0 42px; border: 1px solid transparent; border-radius: 12px; background: var(--e-ctrl); color: var(--e-t1); font-size: 15px; min-width: 0; }\n.e-g2 .e-busca .afty-campo::placeholder { color: var(--e-t3); }\n.e-g2 .e-busca .afty-campo:focus { outline: none; border-color: var(--e-sel-borda); background: var(--e-ctrl-hover); }\n.e-g2 input[type=\"search\"]::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }\n.e-g2 .e-limpar { position: absolute; right: 6px; width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 8px; background: none; color: var(--e-t2); }\n.e-g2 .e-limpar:hover { background: var(--e-ctrl-hover); color: var(--e-t1); }\n.e-g2 .e-contagem { margin: 0; display: flex; align-items: baseline; gap: 14px; font-size: 13.5px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .e-contagem b { color: var(--e-t1); font-variant-numeric: var(--e-num); }\n.e-g2 .e-contagem [data-onde] { display: inline-flex; gap: 5px; align-items: baseline; }\n.e-g2 .e-contagem [data-onde=\"nome\"]::before, .e-g2 .e-onde[data-onde=\"nome\"]::before { content: \"\"; width: 8px; height: 8px; border-radius: 2px; background: var(--afty-destaque); align-self: center; }\n.e-g2 .e-contagem [data-onde=\"texto\"]::before { content: \"\"; width: 8px; height: 8px; border-radius: 2px; background: color-mix(in oklab, var(--afty-aviso) 70%, transparent); align-self: center; }\n.e-g2 .e-efeitos { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\n.e-g2 .e-efeitos-rotulo { font: 600 13px var(--e-display); font-stretch: semi-condensed; color: var(--e-t3); margin-right: 4px; }\n.e-g2 .e-efeito { height: 30px; padding: 0 12px; border: 1px solid transparent; border-radius: 8px; background: var(--e-ctrl); color: var(--e-t2); font-size: 13.5px; font-weight: 600; }\n.e-g2 .e-efeito:hover { color: var(--e-t1); }\n.e-g2 .e-efeito[aria-checked=\"true\"] { background: var(--e-sel); border-color: var(--e-sel-borda); color: var(--e-t1); }\n\n.e-g2 .e-tecnica { width: 100%; display: flex; align-items: center; gap: 10px; margin: 2px 0 0; padding: 12px 16px; border: 1px solid var(--e-painel-borda); border-radius: 14px; background: var(--e-painel); color: var(--e-t1); text-align: left; flex-wrap: wrap; }\n.e-g2 .e-tecnica:hover { border-color: var(--e-ctrl-borda); }\n.e-g2 .e-tecnica[data-consultada] { border-color: var(--e-sel-borda); background: var(--e-sel); }\n.e-g2 .e-tecnica > svg:first-child { color: var(--e-ativo); }\n.e-g2 .e-tecnica-nome { font: 600 16px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .e-tecnica-seta { margin-left: auto; color: var(--e-t3); }\n.e-g2 .e-tecnica .e-trecho { flex-basis: 100%; padding-left: 26px; }\n\n.e-g2 .e-grupo { margin-top: 14px; border: 1px solid var(--e-painel-borda); border-radius: 14px; background: var(--e-painel); overflow: hidden; }\n.e-g2 .e-grupo-topo { display: flex; align-items: center; gap: 16px; padding: 11px 16px; background: color-mix(in oklab, var(--afty-texto) 3%, transparent); border-bottom: 1px solid var(--e-linha); }\n.e-g2 .e-grupo-titulo { margin: 0; display: flex; align-items: baseline; gap: 8px; font: 600 17px var(--e-display); font-stretch: semi-condensed; color: var(--e-t1); }\n.e-g2 .e-grupo-titulo small { font-size: 14px; font-weight: 400; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .e-subabas { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: var(--e-ctrl); }\n.e-g2 .e-subaba { display: inline-flex; align-items: baseline; gap: 6px; height: 30px; padding: 0 12px; border: 0; border-radius: 7px; background: none; color: var(--e-t2); font-size: 13.5px; font-weight: 600; line-height: 30px; }\n.e-g2 .e-subaba small { font-weight: 400; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .e-subaba[aria-selected=\"true\"] { background: color-mix(in oklab, var(--afty-card) 60%, var(--afty-texto) 14%); color: var(--e-t1); }\n\n/* A linha em flex, com prioridade quando falta espaço (lista estreita, painel\n   aberto): nome, estado e controles nunca encolhem; encolhem primeiro as\n   marcas e os rótulos dos controles, com reticências e o title. */\n.e-g2 .e-linha { position: relative; display: flex; align-items: center; min-height: 48px; padding-right: 16px; border-top: 1px solid var(--e-linha); }\n.e-g2 .e-linha > .e-estrela { flex: none; }\n.e-g2 .e-linha > .e-linha-corpo { flex: 1 1 0; min-width: min-content; }\n.e-g2 .e-grupo-lista .e-linha:first-child { border-top: 0; }\n.e-g2 .e-linha:hover { background: var(--e-hover); }\n.e-g2 .e-linha[data-consultada] { background: var(--e-sel); }\n.e-g2 .e-linha[data-consultada]::before { content: \"\"; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--afty-destaque); }\n.e-g2 .e-estrela { align-self: stretch; display: inline-flex; align-items: center; justify-content: center; width: 40px; padding: 0; border: 0; background: none; color: transparent; }\n.e-g2 .e-estrela svg { width: 15px; height: 15px; }\n.e-g2 .e-linha:hover .e-estrela, .e-g2 .e-estrela:focus-visible { color: var(--e-t3); }\n.e-g2 .e-estrela[aria-pressed=\"true\"] { color: var(--e-t2); }\n.e-g2 .e-estrela:hover { color: var(--e-t1) !important; }\n.e-g2 .e-linha-corpo { min-width: 0; align-self: stretch; display: flex; align-items: center; padding: 0; border: 0; background: none; color: var(--e-t1); text-align: left; cursor: pointer; }\n/* Uma linha só (2026-10-14): nada quebra. Se faltar espaço, as marcas encolhem\n   com reticências antes do nome, que tem o title. */\n.e-g2 .e-linha-topo { flex: 1 1 auto; min-width: 0; display: flex; flex-wrap: nowrap; align-items: baseline; column-gap: 10px; overflow: hidden; }\n.e-g2 .e-nome-item { font-size: 15px; font-weight: 600; line-height: 1.3; }\n.e-g2 .e-linha-topo .e-nome-item { flex: 0 0 auto; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.e-g2 .e-linha-topo > :is(.e-ativo, .e-onde) { flex: none; }\n/* `contain: inline-size`: as marcas não pedem largura, só ocupam a que sobra. Assim\n   elas encolhem ANTES dos rótulos dos controles quando a lista estreita. */\n.e-g2 .e-metas { flex: 1 1 auto; min-width: 0; contain: inline-size; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; color: var(--e-t3); }\n.e-g2 .e-metas .e-marca + .e-marca { margin-left: 10px; }\n.e-g2 .e-ativo { font-size: 13px; font-weight: 600; color: var(--e-ativo); white-space: nowrap; }\n.e-g2 .e-marca { font-size: 12.5px; color: var(--e-t3); white-space: nowrap; }\n/* O ponto separa marcas de texto. Um valor (\"−10 PE\") vem sem ele, na mesma linha de base. */\n.e-g2 .e-marca + .e-marca:not([data-valor])::before { content: \"· \"; }\n.e-g2 .e-onde { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .e-onde:not([data-onde=\"nome\"])::before { content: \"\"; width: 8px; height: 8px; border-radius: 2px; background: color-mix(in oklab, var(--afty-aviso) 70%, transparent); }\n.e-g2 .e-desc { max-width: 84ch; font-size: 14px; line-height: 1.45; color: var(--e-t2); }\n.e-g2 .e-trecho { max-width: 90ch; font-size: 13.5px; line-height: 1.5; color: var(--e-t2); }\n.e-g2 mark { background: color-mix(in oklab, var(--afty-aviso) 32%, transparent); color: var(--e-t1); border-radius: 3px; padding: 0 1px; }\n.e-g2 .e-linha-ctrl { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; gap: 14px; padding-left: 14px; white-space: nowrap; }\n.e-g2 .e-ctrl { min-width: 0; display: inline-flex; align-items: center; gap: 8px; }\n.e-g2 .e-ctrl > :not(.e-ctrl-rotulo) { flex: none; }\n.e-g2 .e-ctrl-rotulo { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 12.5px; font-weight: 600; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .e-pe { display: inline-flex; align-items: center; gap: 5px; height: 26px; padding: 0 8px; border: 1px dashed var(--e-aviso-borda); border-radius: 7px; background: var(--e-aviso-fundo); color: var(--e-aviso); font-size: 12.5px; font-weight: 600; white-space: nowrap; }\n.e-g2 .e-pe svg { width: 13px; height: 13px; color: var(--e-aviso-icone); }\n.e-g2 .e-vazio { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px 20px; color: var(--e-t2); }\n.e-g2 .e-vazio p { margin: 0; }\n.e-g2 .e-vazio b { color: var(--e-t1); }\n.e-g2 .e-respiro { height: 72px; }\n\n/* ---------------- consulta sob demanda ---------------- */\n.e-g2 .e-consulta { position: absolute; z-index: 10; top: 10px; right: 0; bottom: 14px; width: min(580px, 47%); display: flex; flex-direction: column; border: 1px solid var(--e-ctrl-borda); border-radius: 16px; background: var(--e-flutuante); box-shadow: -24px 0 60px -28px rgb(0 0 0 / .95), 0 24px 50px -30px rgb(0 0 0 / .9); }\n.e-g2 .e-consulta-topo { flex: none; display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 10px; border-bottom: 1px solid var(--e-linha); }\n.e-g2 .e-consulta-abas { flex: 1; min-width: 0; display: flex; gap: 4px; overflow: hidden; }\n.e-g2 .e-consulta-aba { min-width: 0; max-width: 200px; display: inline-flex; align-items: center; height: 34px; border-radius: 9px; color: var(--e-t2); }\n.e-g2 .e-consulta-aba > button:first-child { min-width: 0; height: 34px; padding: 0 4px 0 11px; border: 0; background: none; font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.e-g2 .e-consulta-aba:hover { color: var(--e-t1); background: var(--e-hover); }\n.e-g2 .e-consulta-aba[data-ativa] { background: var(--e-ctrl-hover); color: var(--e-t1); }\n.e-g2 .e-consulta-aba-x { flex: none; width: 28px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border: 0; background: none; color: var(--e-t3); }\n.e-g2 .e-consulta-aba-x:hover { color: var(--e-t1); }\n.e-g2 .e-consulta-aba-x svg { width: 13px; height: 13px; }\n.e-g2 .e-fechar { flex: none; display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 10px 0 12px; border: 1px solid var(--e-ctrl-borda); border-radius: 9px; background: none; color: var(--e-t1); font-size: 13.5px; font-weight: 600; }\n.e-g2 .e-fechar:hover { background: var(--e-ctrl); }\n.e-g2 .e-fechar kbd { font: 600 11.5px var(--afty-fonte); padding: 1px 5px; border: 1px solid var(--e-ctrl-borda); border-radius: 5px; color: var(--e-t2); }\n.e-g2 .e-consulta-corpo { flex: 1; min-height: 0; overflow: auto; padding: 18px 24px 32px; outline: none; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .e-consulta-cabeca { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }\n.e-g2 .e-sobre { margin: 0 0 4px; font-size: 13px; color: var(--e-t2); }\n.e-g2 .e-consulta-titulo { margin: 0; font: 600 27px/1.1 var(--e-display); font-stretch: semi-condensed; outline: none; }\n.e-g2 .e-consulta-cabeca .e-ativo { margin: 6px 0 0; }\n.e-g2 .e-fixar { flex: none; display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 11px; border: 0; border-radius: 9px; background: none; color: var(--e-t2); font-size: 13.5px; font-weight: 600; }\n.e-g2 .e-fixar:hover { background: var(--e-ctrl); color: var(--e-t1); }\n.e-g2 .e-fixar[aria-pressed=\"true\"] { color: var(--e-t1); }\n.e-g2 .e-fixar svg { width: 15px; height: 15px; }\n.e-g2 .e-bloco { margin-top: 20px; }\n.e-g2 .e-bloco-titulo { margin: 0 0 8px; font: 600 15px var(--e-display); font-stretch: semi-condensed; color: var(--e-t2); letter-spacing: .01em; }\n.e-g2 .e-resumo { padding: 12px 14px; border-left: 3px solid var(--afty-destaque); border-radius: 0 10px 10px 0; background: color-mix(in oklab, var(--afty-destaque) 9%, transparent); }\n.e-g2 .e-resumo .e-bloco-titulo { margin-bottom: 4px; }\n.e-g2 .e-resumo p { margin: 0; font-size: 15px; line-height: 1.5; }\n.e-g2 .e-controle { display: grid; gap: 8px; padding: 10px 0; border-top: 1px solid var(--e-linha); }\n.e-g2 .e-bloco-controles .e-bloco-titulo + .e-controle, .e-g2 .e-bloco-controles .e-fora + .e-controle { border-top: 0; padding-top: 2px; }\n.e-g2 .e-controle-filho { padding: 8px 0 0 14px; border-top: 0; border-left: 2px solid var(--e-linha); }\n.e-g2 .e-controle-nome { font-size: 14px; font-weight: 600; }\n.e-g2 .e-controle-de { margin-left: 8px; font-size: 12.5px; font-weight: 500; color: var(--e-t3); }\n.e-g2 .e-agora-item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }\n.e-g2 .e-agora-item > span { font-size: 12.5px; font-weight: 600; color: var(--e-t3); }\n.e-g2 .e-fora { margin: 0 0 8px; display: flex; align-items: center; gap: 12px; font-size: 13.5px; color: var(--e-t2); }\n.e-g2 .e-nota-pe { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 8px 10px; margin-top: 10px; padding: 11px 12px; border: 1px solid var(--e-aviso-borda); border-radius: 10px; background: var(--e-aviso-fundo); font-size: 13.5px; line-height: 1.45; }\n.e-g2 .e-nota-pe > svg { color: var(--e-aviso-icone); margin-top: 2px; }\n.e-g2 .e-nota-pe b { color: var(--e-aviso); }\n.e-g2 .e-nota-pe .afty-botao { grid-column: 2; justify-self: start; }\n.e-g2 .e-escolha { padding: 6px 0 8px 14px; border-left: 2px solid var(--e-linha); }\n.e-g2 .e-escolha + .e-escolha { margin-top: 8px; }\n.e-g2 .e-escolha[data-ligada] { border-left-color: var(--afty-destaque); }\n.e-g2 .e-escolha h4 { margin: 0 0 3px; display: flex; align-items: baseline; gap: 10px; font-size: 14.5px; font-weight: 700; }\n.e-g2 .e-texto { max-width: 36em; font-size: 15.5px; line-height: 1.65; color: var(--e-t1); }\n.e-g2 .e-escolha .e-texto { font-size: 14.5px; color: color-mix(in oklab, var(--afty-texto) 86%, var(--afty-fundo)); }\n.e-g2 .e-texto p { margin: 0 0 .85em; }\n.e-g2 .e-texto p:last-child { margin-bottom: 0; }\n.e-g2 .e-texto .afty-tr { font-size: inherit !important; line-height: inherit !important; color: inherit !important; }\n.e-g2 .e-texto .afty-tr-forte { color: inherit !important; font-weight: 700; }\n.e-g2 .e-texto .afty-tr-p { white-space: pre-wrap; margin: 0 0 .85em; }\n.e-g2 .e-texto :is(.afty-tr-h1, .afty-tr-h2) { color: inherit !important; font-size: 16px; font-weight: 700; margin: 1.1em 0 .4em; border: 0 !important; }\n/* O `TextoRico` do repositório traz o espaçamento da tabela em classes do\n   Tailwind, que o protótipo não carrega: o mínimo vem daqui. */\n.e-g2 .e-texto .afty-tr-tabela-caixa { margin: 8px 0 .85em; overflow-x: auto; }\n.e-g2 .e-texto .afty-tr-tabela { width: 100%; font-size: 13.5px; border-collapse: collapse; }\n.e-g2 .e-texto .afty-tr-tabela :is(th, td) { padding: 4px 8px; }\n\n/* ---------------- controles (peças compartilhadas) ---------------- */\n.e-g2 .afty-botao.e-botao, .e-g2 .m-botao { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 32px; padding: 0 12px; border: 1px solid var(--e-ctrl-borda); border-radius: 8px; background: none; color: var(--e-t1); font-size: 13.5px; font-weight: 600; white-space: nowrap; }\n.e-g2 .e-botao:hover:not(:disabled), .e-g2 .m-botao:hover:not(:disabled) { background: var(--e-ctrl); }\n.e-g2 .m-botao:disabled { color: var(--e-t3); border-color: var(--e-linha); }\n.e-g2 .m-botao-dano { color: var(--afty-pv); }\n.e-g2 .m-botao-cura { color: var(--afty-cura); }\n.e-g2 .afty-campo { height: 34px; min-width: 0; padding: 0 10px; border: 1px solid transparent; border-radius: 8px; background: var(--e-ctrl); color: var(--e-t1); font-size: 14px; }\n.e-g2 .m-campo-num { width: 60px; text-align: center; font-variant-numeric: var(--e-num); }\n.e-g2 .m-rotulo { font-size: 12.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .m-link { display: inline-flex; gap: 5px; border: 0; background: none; padding: 2px 0; color: var(--e-ativo); font-size: 13.5px; font-weight: 600; }\n.e-g2 .m-erro { color: var(--e-aviso); font-weight: 600; }\n.e-g2 .m-seg { display: inline-flex; padding: 3px; gap: 2px; border-radius: 10px; background: var(--e-ctrl); }\n.e-g2 .m-seg-op { height: 30px; padding: 0 12px; border: 0; border-radius: 7px; background: none; color: var(--e-t2); font-size: 13.5px; font-weight: 600; white-space: nowrap; }\n.e-g2 .m-seg-op:hover:not(:disabled) { color: var(--e-t1); background: var(--e-hover); }\n.e-g2 .m-seg-op:is([aria-checked=\"true\"], [aria-pressed=\"true\"]) { background: color-mix(in oklab, var(--afty-destaque) 30%, transparent); color: var(--e-t1); box-shadow: inset 0 0 0 1px var(--e-sel-borda); }\n.e-g2 .m-seg-op:first-child[role=\"radio\"][aria-checked=\"true\"] { background: var(--e-ctrl-hover); box-shadow: none; }\n.e-g2 .m-seg-op:disabled { color: var(--e-t3); }\n.e-g2 .m-chave { display: inline-flex; align-items: center; gap: 9px; height: 30px; border: 0; background: none; padding: 0; color: var(--e-t2); font-size: 13.5px; font-weight: 600; }\n.e-g2 .m-chave-trilho { position: relative; width: 36px; height: 20px; border-radius: 10px; background: var(--e-ctrl-borda); }\n.e-g2 .m-chave-trilho span { position: absolute; left: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--e-t2); transition: left .15s; }\n.e-g2 .m-chave[aria-checked=\"true\"] { color: var(--e-t1); }\n.e-g2 .m-chave[aria-checked=\"true\"] .m-chave-trilho { background: var(--afty-destaque); }\n.e-g2 .m-chave[aria-checked=\"true\"] .m-chave-trilho span { left: 19px; background: #fff; }\n.e-g2 .m-chave:disabled { color: var(--e-t3); }\n.e-g2 .m-ctrl { display: inline-flex; align-items: center; gap: 10px; }\n.e-g2 .m-custo { font-size: 13px; font-weight: 600; color: var(--afty-pe); }\n.e-g2 .m-passos { display: inline-flex; align-items: center; gap: 4px; }\n.e-g2 .m-passo { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border: 0; border-radius: 8px; background: var(--e-ctrl); color: var(--e-t1); }\n.e-g2 .m-passo:disabled { color: var(--e-t3); }\n.e-g2 .m-passos-valor { min-width: 44px; text-align: center; font: 700 16px var(--e-display); font-variant-numeric: var(--e-num); }\n.e-g2 .m-passos-valor small { font-weight: 400; color: var(--e-t2); }\n.e-g2 .m-select { position: relative; display: inline-flex; align-items: center; }\n.e-g2 .m-select select { appearance: none; padding-right: 30px; font-weight: 600; }\n.e-g2 .m-select svg { position: absolute; right: 9px; width: 14px; height: 14px; color: var(--e-t2); pointer-events: none; }\n.e-g2 .m-deltas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; }\n.e-g2 .m-deltas li { display: inline-flex; align-items: baseline; gap: 6px; font-size: 13.5px; }\n.e-g2 .m-deltas li span { color: var(--e-t2); }\n.e-g2 .m-deltas li b { font-weight: 700; font-variant-numeric: var(--e-num); }\n.e-g2 .m-deltas li[data-sinal=\"mais\"] b { color: var(--afty-cura); }\n.e-g2 .m-deltas li[data-sinal=\"menos\"] b { color: var(--afty-pv); }\n.e-g2 .m-flutuante { z-index: 90; overflow: auto; padding: 12px; border: 1px solid var(--e-ctrl-borda); border-radius: 12px; background: var(--e-flutuante); color: var(--e-t1); box-shadow: 0 20px 44px -12px rgb(0 0 0 / .6); }\n.e-g2 .m-flutuante[data-dica] { pointer-events: none; }\n.e-g2 .m-chip-painel { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }\n.e-g2 .e-menu { display: flex; flex-direction: column; margin: -6px; }\n.e-g2 .e-menu-item { height: 38px; padding: 0 12px; border: 0; border-radius: 8px; background: none; text-align: left; font-size: 14px; color: var(--e-t1); }\n.e-g2 .e-menu-item:hover { background: var(--e-ctrl); }\n.e-g2 .e-menu-confirma { color: var(--e-aviso); font-weight: 700; }\n.e-g2 .m-painel-vital { display: flex; flex-direction: column; gap: 10px; min-width: 260px; }\n.e-g2 .m-pv-titulo { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; }\n.e-g2 .m-pv-numero { font: 700 18px var(--e-display); font-variant-numeric: var(--e-num); }\n.e-g2 .m-pv-numero small { font-size: 13px; font-weight: 400; color: var(--e-t2); }\n.e-g2 .m-pv-linha { display: flex; gap: 6px; flex-wrap: wrap; }\n.e-g2 .m-pv-motivo { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--e-t2); }\n.e-g2 .m-pv-definir { align-self: flex-start; }\n.e-g2 .m-pv-bloco { display: grid; gap: 4px; padding-top: 8px; border-top: 1px solid var(--e-linha); }\n.e-g2 .m-pv-rodape { display: flex; justify-content: flex-end; }\n.e-g2 .pf-fontes { min-width: 220px; font-size: 13.5px; }\n.e-g2 .pf-fontes-titulo { font-weight: 700; margin-bottom: 6px; }\n.e-g2 .pf-fontes-linha, .e-g2 .pf-fontes-secao, .e-g2 .pf-fontes-total { display: flex; justify-content: space-between; gap: 18px; padding: 4px 0; }\n.e-g2 .pf-fontes-linha { border-bottom: 1px solid var(--e-linha); }\n.e-g2 .pf-fontes-linha span { color: var(--e-t2); }\n.e-g2 .pf-fontes-linha b, .e-g2 .pf-fontes-total b { font-weight: 600; font-variant-numeric: var(--e-num); }\n.e-g2 .pf-fontes-total { font-weight: 700; }\n.e-g2 .m-aviso-flutuante { position: absolute; z-index: 85; left: 50%; bottom: 24px; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; padding: 9px 14px; border: 1px solid var(--e-ctrl-borda); border-radius: 12px; background: var(--e-flutuante); box-shadow: 0 14px 34px -10px rgb(0 0 0 / .6); font-size: 13.5px; }\n\n/* ========== GESTOR (efeitos/gestor.css) ========== */\n/* ============================================================\n   GERENCIADOR DE EFEITOS · acabamento\n   ============================================================\n   Neutro por padrão. A hierarquia vem do tipo (Bahnschrift no título,\n   Segoe no corpo), do alinhamento em colunas e do espaço entre linhas.\n   Três destaques, e só estes:\n     violeta   seleção e a ação em foco\n     âmbar     o que pede atenção de verdade (cobrança que vem, Exaustão,\n               regra pendente, PE que falta)\n     vermelho  consequência negativa no resultado de uma operação\n   As barras do cabeçalho mantêm as cores da rodada 6. Todo número leva o\n   sinal escrito e o rótulo: dá para ler sem cor.\n   Uma superfície por coluna, fio fino entre as linhas, sem caixa por linha.\n   ============================================================ */\n\n/* ---------------- esqueleto ---------------- */\n.e-g2, .e-g2 :is(.afty-card, .e-consulta, .m-flutuante) { --f-t3: color-mix(in oklab, var(--afty-texto-suave) 86%, var(--afty-fundo)); }\n.e-g2 .f-aba-n { margin-left: 6px; font-size: 13px; font-weight: 400; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n\n/* O acesso no Agora */\n.e-g2 .f-acesso { display: inline-flex; align-items: center; gap: 7px; height: 30px; padding: 0 10px; border: 1px solid var(--e-ctrl-borda); border-radius: 8px; background: none; color: var(--e-t1); font-size: 13.5px; font-weight: 600; white-space: nowrap; }\n.e-g2 .f-acesso svg { width: 14px; height: 14px; color: var(--e-t2); }\n.e-g2 .f-acesso b { font: 700 15px var(--e-display); font-variant-numeric: var(--e-num); }\n.e-g2 .f-acesso[aria-pressed=\"true\"] { border-color: var(--e-sel-borda); background: var(--e-sel); }\n.e-g2 .f-acesso-atencao { display: inline-flex; align-items: center; gap: 4px; margin-left: 2px; padding-left: 8px; border-left: 1px solid var(--e-ctrl-borda); color: var(--e-aviso); font-weight: 700; }\n.e-g2 .f-acesso-atencao svg { color: var(--e-aviso-icone); width: 13px; height: 13px; }\n\n/* ---------------- peças de texto ---------------- */\n.e-g2 .g-titulo { margin: 0; display: flex; align-items: baseline; gap: 8px; font: 600 19px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .g-titulo small { font-size: 14px; font-weight: 400; color: var(--f-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .g-subtitulo { margin: 18px 0 6px; display: flex; align-items: baseline; gap: 8px; font: 600 14px var(--e-display); font-stretch: semi-condensed; letter-spacing: .01em; color: var(--e-t2); }\n.e-g2 .g-subtitulo small { font-weight: 400; color: var(--f-t3); }\n.e-g2 .g-rotulo { font-size: 12.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .g-suave { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: var(--f-t3); }\n.e-g2 .g-suave svg { width: 13px; height: 13px; }\n.e-g2 .g-origem { font-size: 12.5px; color: var(--f-t3); white-space: nowrap; }\n.e-g2 .g-origem > span + span::before { content: \" · \"; }\n/* A duração que resta: discreta, e no mesmo lugar nas duas apresentações. */\n.e-g2 .g-origem [data-duracao] { color: var(--e-t2); }\n.e-g2 .g-empate { display: inline-flex; align-items: center; gap: 4px; margin-left: 8px; font-size: 12.5px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .g-empate svg { width: 12px; height: 12px; }\n.e-g2 .g-bloco-pv { flex-direction: column; align-items: flex-start; gap: 2px; }\n.e-g2 .g-reativar { margin-left: auto; display: inline-flex; align-items: center; gap: 10px; }\n.e-g2 .g-nome { font-size: 15px; font-weight: 600; line-height: 1.3; color: var(--e-t1); }\n.e-g2 .g-vazio { margin: 0; padding: 22px 12px; text-align: center; color: var(--e-t2); }\n.e-g2 .g-link { display: inline-flex; align-items: center; gap: 5px; padding: 0; border: 0; background: none; color: var(--e-t1); font-size: 13px; font-weight: 600; text-decoration: underline; text-decoration-color: var(--e-ctrl-borda); text-underline-offset: 3px; }\n.e-g2 .g-link:hover { text-decoration-color: var(--e-t2); }\n.e-g2 .g-link svg { width: 14px; height: 14px; }\n\n/* Números: rótulo neutro, valor com sinal. Vermelho só com `destaque`. */\n.e-g2 .g-numeros { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }\n.e-g2 .g-num { font-size: 13.5px; white-space: nowrap; }\n.e-g2 .g-num span { color: var(--e-t2); }\n.e-g2 .g-num b { font-weight: 700; color: var(--e-t1); font-variant-numeric: var(--e-num); }\n.e-g2 .g-num[data-sinal=\"menos\"] b { color: var(--afty-pv); }\n.e-g2 .g-mais { margin-left: 8px; font-size: 12.5px; color: var(--f-t3); }\n\n/* Custo: o ícone e a palavra dizem quem paga, sem cor. */\n.e-g2 .g-custo { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .g-custo svg { width: 13px; height: 13px; color: var(--e-t2); }\n\n/* Marcas discretas da linha */\n.e-g2 .g-marca { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .g-marca svg { width: 13px; height: 13px; color: var(--f-t3); }\n.e-g2 .g-marca[data-tom=\"atencao\"] { color: var(--e-aviso); font-weight: 600; }\n.e-g2 .g-marca[data-tom=\"atencao\"] svg { color: var(--e-aviso-icone); }\n\n/* ---------------- botões ---------------- */\n.e-g2 .g-botao { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 30px; padding: 0 11px; border: 1px solid var(--e-ctrl-borda); border-radius: 8px; background: none; color: var(--e-t1); font-size: 13px; font-weight: 600; white-space: nowrap; }\n.e-g2 .g-botao:hover:not(:disabled) { background: var(--e-ctrl); }\n.e-g2 .g-botao svg { width: 14px; height: 14px; }\n.e-g2 .g-botao[data-primaria] { border-color: var(--e-sel-borda); background: var(--e-sel); }\n.e-g2 .g-botao[data-primaria]:hover:not(:disabled) { background: color-mix(in oklab, var(--afty-destaque) 28%, transparent); }\n.e-g2 .g-botao:disabled { color: var(--f-t3); border-color: var(--e-linha); background: none; }\n.e-g2 .g-icone { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex: none; border: 0; border-radius: 8px; background: none; color: var(--e-t2); }\n.e-g2 .g-icone:hover { background: var(--e-ctrl); color: var(--e-t1); }\n.e-g2 .g-x { margin-left: auto; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; flex: none; border: 0; border-radius: 7px; background: none; color: var(--f-t3); }\n.e-g2 .g-x:hover { background: var(--e-ctrl); color: var(--e-t1); }\n.e-g2 .g-x svg { width: 14px; height: 14px; }\n.e-g2 .g-encerrar { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; flex: none; border: 0; border-radius: 8px; background: none; color: var(--e-t2); }\n.e-g2 .g-encerrar:hover { background: var(--e-ctrl); color: var(--e-t1); }\n.e-g2 .g-encerrar svg { width: 15px; height: 15px; }\n\n/* ---------------- a lista de ativos ---------------- */\n.e-g2 .g-lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--e-linha); }\n.e-g2 .g-divisao { padding: 14px 10px 5px; font: 600 12.5px var(--e-display); font-stretch: semi-condensed; letter-spacing: .03em; color: var(--f-t3); text-transform: uppercase; }\n.e-g2 .g-lista > .g-divisao:first-child { padding-top: 8px; }\n.e-g2 .g-ativo { position: relative; padding: 6px 4px 7px 10px; border-bottom: 1px solid var(--e-linha); }\n.e-g2 .g-ativo[data-selecionado] { background: var(--e-sel); }\n.e-g2 .g-ativo[data-selecionado]::before { content: \"\"; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--afty-destaque); }\n/* A coluna de ação tem largura fixa: com ou sem passo, as colunas alinham entre as linhas. */\n.e-g2 .g-ativo-linha { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .8fr) minmax(0, 1.25fr) 128px; align-items: center; column-gap: 14px; min-height: 34px; }\n.e-g2 .g-ativo-nome { min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; padding: 2px 0; border: 0; background: none; color: var(--e-t1); text-align: left; cursor: pointer; }\n.e-g2 .g-ativo-nome:hover .g-nome { text-decoration: underline; text-decoration-color: var(--e-ctrl-borda); text-underline-offset: 3px; }\n.e-g2 .g-valor { min-width: 0; display: flex; flex-wrap: wrap; gap: 0 10px; font-size: 13.5px; font-weight: 600; color: var(--e-t1); }\n.e-g2 .g-valor small { font-size: 12.5px; font-weight: 500; color: var(--e-t2); }\n.e-g2 .g-consequencia { min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; }\n.e-g2 .g-acoes { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }\n.e-g2 .g-acoes .m-passo { width: 26px; height: 26px; }\n.e-g2 .g-acoes .m-passos-valor { min-width: 36px; font-size: 14.5px; }\n.e-g2 .g-acoes .m-custo { display: none; }\n.e-g2 .g-marcas { display: flex; flex-wrap: wrap; gap: 2px 14px; padding: 1px 0 0; }\n\n/* O detalhe: recuado, sem caixa */\n.e-g2 .g-detalhe { display: grid; gap: 10px; padding: 8px 8px 6px 0; }\n.e-g2 .g-bloco { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }\n.e-g2 .g-frases { margin: 0; padding: 0; list-style: none; display: grid; gap: 3px; font-size: 13.5px; line-height: 1.45; color: var(--e-t1); }\n.e-g2 .g-frases li { padding-left: 12px; border-left: 2px solid var(--e-linha); }\n.e-g2 .g-frases li[data-tom=\"atencao\"] { border-left-color: var(--e-aviso-borda); }\n.e-g2 .g-controles { display: grid; gap: 10px; }\n.e-g2 .g-controle { display: grid; gap: 5px; justify-items: start; }\n.e-g2 .g-controle-filho { padding-left: 12px; border-left: 2px solid var(--e-linha); }\n.e-g2 .g-controle-nome { font-size: 12.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .g-controle-nome small { font-size: inherit; font-weight: 500; color: var(--f-t3); }\n.e-g2 .g-controle .m-seg { flex-wrap: wrap; }\n.e-g2 .g-ficha { margin: 0; display: grid; gap: 3px; font-size: 13px; }\n.e-g2 .g-ficha div { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 10px; }\n.e-g2 .g-ficha dt { color: var(--e-t2); }\n.e-g2 .g-ficha dd { margin: 0; color: var(--e-t1); }\n.e-g2 .g-descricao { margin: 0; max-width: 62ch; font-size: 13.5px; line-height: 1.5; color: var(--e-t2); }\n.e-g2 .g-regra { justify-self: start; }\n.e-g2 .g-pv { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; font-size: 13.5px; }\n.e-g2 .g-pv b { font-variant-numeric: var(--e-num); }\n\n/* O resultado: uma linha abaixo do que foi operado, sem cobrir nada */\n.e-g2 .g-resultado { display: flex; flex-wrap: wrap; align-items: center; gap: 3px 14px; margin: 5px 0 1px; padding: 5px 4px 5px 10px; border-left: 2px solid var(--e-sel-borda); background: color-mix(in oklab, var(--afty-texto) 3.5%, transparent); border-radius: 0 6px 6px 0; animation: g-entra .2s ease-out; }\n.e-g2 .g-resultado[data-tom=\"nada\"] { border-left-color: var(--e-aviso-borda); background: var(--e-aviso-fundo); }\n.e-g2 .g-na-ficha { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }\n.e-g2 .g-razao { font-size: 13px; color: var(--e-t1); }\n.e-g2 .g-resultado-verbo { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 700; color: var(--e-t1); }\n.e-g2 .g-resultado-verbo svg { width: 14px; height: 14px; color: var(--e-t2); }\n.e-g2 .g-resultado[data-tom=\"nada\"] .g-resultado-verbo svg { color: var(--e-aviso-icone); }\n@keyframes g-entra { from { opacity: 0; } to { opacity: 1; } }\n\n/* Encerrados */\n.e-g2 .g-encerrados ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--e-linha); }\n.e-g2 .g-encerrados li { padding: 5px 4px 5px 10px; border-bottom: 1px solid var(--e-linha); }\n.e-g2 .g-encerrado-linha { display: flex; align-items: center; gap: 10px; min-height: 32px; }\n.e-g2 .g-encerrado-linha .g-nome { color: var(--e-t2); font-weight: 500; }\n\n\n/* ---------------- a completa ---------------- */\n.e-g2 .g-completa { flex: 1; min-width: 0; min-height: 0; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 26px; }\n/* Ao entrar, só os ativos: uma coluna com largura de leitura. Encontrar e o\n   registro abrem ao lado, sob pedido, e aí volta a divisão de duas colunas. */\n.e-g2 .g-completa:not([data-lado]) { grid-template-columns: minmax(0, 900px); }\n/* A regra aberta ocupa a direita da área. A coluna única estreita para ficar\n   inteira ao lado dela, e a lista continua operável com a regra aberta. */\n.e-g2 .e-area[data-consultando] .g-completa:not([data-lado]) { grid-template-columns: minmax(0, min(900px, calc(100% - min(560px, 48%) - 24px))); }\n.e-g2 .g-col { min-height: 0; overflow: auto; padding: 14px 6px 48px 0; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .g-cabeca { display: flex; align-items: center; gap: 12px; min-height: 34px; margin: 0 0 8px; }\n.e-g2 .g-cabeca-acoes { margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }\n/* O botão aceso diz o que está aberto ao lado. */\n.e-g2 .g-botao[aria-pressed=\"true\"] { border-color: var(--e-sel-borda); background: var(--e-sel); }\n\n/* Encontrar */\n.e-g2 .g-ferramentas { display: grid; gap: 8px; margin-bottom: 4px; }\n.e-g2 .g-busca { position: relative; display: flex; align-items: center; }\n.e-g2 .g-busca > svg { position: absolute; left: 12px; color: var(--e-t2); pointer-events: none; }\n.e-g2 .g-busca .afty-campo { flex: 1; height: 38px; padding: 0 36px 0 38px; border-radius: 10px; font-size: 14.5px; }\n.e-g2 .g-busca .afty-campo:focus { outline: none; border-color: var(--e-sel-borda); background: var(--e-ctrl-hover); }\n.e-g2 .g-limpar { position: absolute; right: 5px; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 7px; background: none; color: var(--e-t2); }\n.e-g2 .g-filtros { display: flex; flex-wrap: wrap; gap: 6px; }\n/* Sem espaço, os menus quebram de linha em vez de cortar o texto. */\n.e-g2 .g-select { flex: 1 1 140px; min-width: 140px; }\n.e-g2 .g-select:first-child { flex-basis: 172px; min-width: 172px; }\n.e-g2 .g-select select { width: 100%; height: 30px; font-size: 13px; }\n.e-g2 .g-alterna { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 8px; background: var(--e-ctrl); color: var(--e-t2); }\n.e-g2 .g-alterna[aria-pressed=\"true\"] { border-color: var(--e-sel-borda); background: var(--e-sel); color: var(--e-t1); }\n.e-g2 .g-alterna svg { width: 14px; height: 14px; }\n.e-g2 .g-contagem { margin: 2px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; font-size: 13px; color: var(--e-t2); }\n.e-g2 .g-contagem b { color: var(--e-t1); font-variant-numeric: var(--e-num); }\n.e-g2 .g-contagem .g-link { margin-left: auto; }\n.e-g2 .g-secao .g-subtitulo { margin-top: 16px; }\n.e-g2 .g-mais-itens { margin: 6px 0 0 36px; }\n\n.e-g2 .g-opcao { display: grid; grid-template-columns: 30px minmax(0, 1fr) 118px 34px; align-items: start; column-gap: 10px; padding: 8px 0 9px; border-bottom: 1px solid var(--e-linha); }\n.e-g2 .g-opcao[data-aberta] { background: var(--e-sel); }\n.e-g2 .g-estrela { height: 26px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 0; background: none; color: var(--f-t3); }\n.e-g2 .g-estrela svg { width: 14px; height: 14px; }\n.e-g2 .g-estrela[aria-pressed=\"true\"] { color: var(--e-t1); }\n.e-g2 .g-opcao-corpo { min-width: 0; display: grid; gap: 2px; }\n.e-g2 .g-opcao-topo { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }\n.e-g2 .g-ativo-marca { font-size: 12.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .g-ativo-marca::before { content: \"● \"; font-size: 8px; vertical-align: 2px; color: var(--e-t2); }\n.e-g2 .g-frase { font-size: 14px; line-height: 1.4; color: var(--e-t2); }\n.e-g2 .g-trecho { font-size: 13px; line-height: 1.45; color: var(--e-t2); }\n.e-g2 mark { background: color-mix(in oklab, var(--afty-texto) 16%, transparent); color: var(--e-t1); border-radius: 3px; padding: 0 1px; }\n.e-g2 .g-opcao-sub { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; }\n.e-g2 .g-evidencia { font-size: 13px; font-weight: 600; color: var(--e-t1); }\n.e-g2 .g-evidencia[data-prova=\"regra\"] { font-weight: 500; color: var(--e-t2); }\n/* O controle de uso: coluna própria, com fio à esquerda. */\n.e-g2 .g-opcao-acoes { align-self: stretch; display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: 3px; padding-left: 10px; border-left: 1px solid var(--e-linha); }\n.e-g2 .g-opcao-acoes .g-botao { width: 100%; }\n/* O custo cabe na coluna: quebra em duas linhas em vez de passar por cima do fio. */\n.e-g2 .g-opcao-acoes .g-custo { justify-content: center; align-items: flex-start; font-size: 12.5px; line-height: 1.3; white-space: normal; text-align: center; }\n.e-g2 .g-opcao-acoes .g-custo svg { flex: none; margin-top: 2px; }\n.e-g2 .g-opcao-acoes > .g-suave { justify-content: center; text-align: center; }\n.e-g2 .g-opcao-regra { align-self: center; }\n.e-g2 .g-condicao { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: var(--e-t1); }\n.e-g2 .g-condicao svg { width: 13px; height: 13px; color: var(--e-t2); }\n.e-g2 .g-acao { display: inline-flex; flex-direction: column; align-items: flex-end; gap: 2px; }\n.e-g2 .g-acao .g-custo { font-size: 12px; }\n\n/* Registrar fonte externa */\n.e-g2 .g-registro { display: grid; gap: 12px; }\n.e-g2 .g-registro-topo { display: flex; align-items: center; gap: 12px; min-height: 34px; }\n.e-g2 .g-tipos { flex-wrap: wrap; justify-self: start; }\n.e-g2 .g-campo { position: relative; display: grid; gap: 4px; font-size: 12.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .g-campo .afty-campo { width: 100%; font-weight: 500; }\n.e-g2 .g-campo-curto .afty-campo { width: 84px; }\n.e-g2 .g-campo-origem .g-suave { font-weight: 500; }\n.e-g2 .g-sugestoes { position: absolute; z-index: 5; top: 100%; left: 0; right: 0; margin: 4px 0 0; padding: 4px; list-style: none; border: 1px solid var(--e-ctrl-borda); border-radius: 10px; background: var(--e-flutuante); box-shadow: 0 16px 30px -14px rgb(0 0 0 / .8); }\n.e-g2 .g-sugestoes button { width: 100%; display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 7px 9px; border: 0; border-radius: 7px; background: none; color: var(--e-t1); text-align: left; font-size: 13.5px; }\n.e-g2 .g-sugestoes button:hover, .e-g2 .g-sugestoes button:focus-visible { background: var(--e-ctrl); }\n.e-g2 .g-beneficio { display: flex; gap: 8px; align-items: center; }\n.e-g2 .g-beneficio .m-select { flex: 1; min-width: 0; }\n.e-g2 .g-beneficio .m-select select { width: 100%; }\n.e-g2 .g-campo .g-beneficio .m-campo-num { flex: none; width: 84px; }\n.e-g2 .g-previa { display: grid; gap: 6px; padding: 10px 12px; border-left: 2px solid var(--e-sel-borda); background: color-mix(in oklab, var(--afty-texto) 3.5%, transparent); border-radius: 0 8px 8px 0; }\n.e-g2 .g-presumir { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--e-t1); }\n/* Registrar fica à vista mesmo com o formulário rolado. */\n.e-g2 .g-registro-rodape { position: sticky; bottom: -48px; z-index: 3; display: flex; justify-content: flex-end; padding: 10px 0 12px; margin-bottom: -12px; background: var(--afty-fundo); box-shadow: 0 -10px 12px -10px rgb(0 0 0 / .8); }\n\n/* ---------------- a compacta ---------------- */\n.e-g2 .g-painel { flex: none; width: 372px; min-height: 0; margin: 8px 18px 0 0; display: flex; flex-direction: column; border-left: 1px solid var(--e-painel-borda); }\n@media (min-width: 1400px) { .e-g2 .g-painel { width: 410px; } }\n.e-g2 .g-painel-topo { flex: none; display: flex; align-items: center; gap: 2px; height: 45px; padding: 0 4px 0 14px; border-bottom: 1px solid var(--e-linha); }\n.e-g2 .g-painel-topo .g-titulo { margin-right: auto; font-size: 17px; }\n.e-g2 .g-painel-corpo { flex: 1; min-height: 0; overflow: auto; padding: 8px 4px 16px 14px; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n/* O rodapé guarda o canto do botão dos Livros: nenhuma linha passa por baixo dele. */\n.e-g2 .g-painel-rodape { flex: none; height: 80px; display: flex; align-items: center; gap: 8px; padding: 0 84px 0 14px; border-top: 1px solid var(--e-linha); }\n/* O filtro fica à vista: rolar a lista não esconde qual recorte está valendo. */\n/* ⚠ OPACO. A rodada 8 somava 70% + 7% no color-mix, e o que falta de 100%\n   vira transparência: a lista aparecia por baixo do filtro ao rolar. Aqui a\n   faixa inteira (margem de cima incluída) é da cor do fundo, e o segmentado\n   dentro dela tem cor própria, também opaca. */\n.e-g2 .g-filtro-compacta { position: sticky; top: -8px; z-index: 2; display: flex; gap: 2px; padding: 3px; margin: 0 0 6px; border-radius: 9px; background: color-mix(in oklab, var(--afty-fundo) 92%, var(--afty-texto)); box-shadow: 0 -8px 0 var(--afty-fundo), 0 6px 0 var(--afty-fundo); }\n.e-g2 .g-segmento { flex: 1; display: inline-flex; align-items: baseline; justify-content: center; gap: 5px; height: 28px; padding: 0 6px; border: 0; border-radius: 7px; background: none; color: var(--e-t2); font-size: 12.5px; font-weight: 600; line-height: 28px; white-space: nowrap; }\n.e-g2 .g-segmento small { font-weight: 400; color: var(--f-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .g-segmento[aria-selected=\"true\"] { background: color-mix(in oklab, var(--afty-card) 60%, var(--afty-texto) 14%); color: var(--e-t1); }\n.e-g2 .g-segmento:disabled { opacity: .45; }\n/* Na compacta a linha é nome e controle em cima, o que vale e a consequência embaixo. */\n.e-g2 .g-lista[data-compacta] .g-ativo { padding: 6px 2px 7px 8px; }\n.e-g2 .g-lista[data-compacta] .g-ativo-linha { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: \"nome acoes\" \"sub acoes\"; row-gap: 0; min-height: 0; }\n.e-g2 .g-lista[data-compacta] .g-ativo-nome { grid-area: nome; }\n.e-g2 .g-lista[data-compacta] .g-sub { grid-area: sub; min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 10px; }\n.e-g2 .g-lista[data-compacta] .g-valor { font-size: 13px; }\n.e-g2 .g-lista[data-compacta] .g-acoes { grid-area: acoes; align-self: center; }\n.e-g2 .g-lista[data-compacta] .g-num { font-size: 13px; }\n\n/* Na consulta, o estado ligado é texto neutro: violeta fica para seleção e ação. */\n.e-g2 .e-consulta .e-ativo { color: var(--e-t1); }\n\n/* ========== G2 (efeitos/g2/g2.css) ========== */\n/* ============================================================\n   G2 · CARTÃO ETIQUETA (portado do modelo estático esquemas-efeitos.html)\n   ============================================================\n   Mesmos tokens do estudo.css. Os nomes de classe são os do modelo, para\n   a comparação direta: x-* (peças comuns), d-* (seção e faixa do detalhe),\n   g2-* (cartão), g-tempo (prazo) e k-* (o catálogo do Adicionar).\n   ============================================================ */\n\n.e-g2 .g2-raiz { flex: 1; min-width: 0; min-height: 0; display: flex; }\n\n/* ---------- comuns ---------- */\n.e-g2 .x-rola { flex: 1; min-width: 0; min-height: 0; overflow: auto; padding: 16px 6px 56px 0; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .x-cabeca { display: flex; align-items: center; gap: 12px; min-height: 36px; margin: 0 0 6px; }\n/* O título e o Adicionar ficam à vista com a lista rolada. */\n.e-g2 .x-rola > .x-cabeca { position: sticky; top: -16px; z-index: 5; margin: -16px 0 6px; padding: 16px 0 6px; background: var(--afty-fundo); }\n.e-g2 .x-titulo { margin: 0; font: 600 20px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .x-adicionar { margin-left: auto; border-color: var(--e-sel-borda); background: var(--e-sel); }\n.e-g2 .x-adicionar svg, .e-g2 .m-botao svg { width: 15px; height: 15px; }\n.e-g2 .x-adicionar:disabled { opacity: .5; cursor: not-allowed; }\n.e-g2 .x-atencao { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--e-aviso); }\n.e-g2 .x-atencao svg { flex: none; width: 14px; height: 14px; color: var(--e-aviso-icone); }\n.e-g2 .x-neutro { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; line-height: 1.4; color: var(--e-t2); }\n.e-g2 .x-neutro svg { flex: none; width: 14px; height: 14px; color: var(--e-t3); }\n.e-g2 .x-medidor { display: inline-flex; gap: 3px; vertical-align: middle; }\n.e-g2 .x-medidor i { width: 12px; height: 6px; border-radius: 2px; background: var(--e-ctrl-borda); }\n.e-g2 .x-medidor i[data-on] { background: var(--e-t1); }\n\n/* O conteúdo de um efeito aberto: três colunas e o rodapé */\n.e-g2 .x-col h4 { margin: 0; padding-top: 1px; font: 600 14px var(--e-display); font-stretch: semi-condensed; color: var(--e-t3); }\n.e-g2 .x-col { min-width: 0; display: grid; gap: 8px; align-content: start; }\n.e-g2 .x-colunas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }\n.e-g2 .x-nums { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }\n.e-g2 .x-lado { min-width: 48px; font-size: 13.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .x-num { font-size: 15px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .x-num b { margin-left: 5px; font-weight: 700; color: var(--e-t1); font-variant-numeric: var(--e-num); }\n.e-g2 .x-num[data-sinal=\"menos\"] b { color: var(--afty-pv); }\n.e-g2 .x-linha { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14px; color: var(--e-t2); }\n.e-g2 .x-texto { font-size: 14.5px; line-height: 1.5; color: var(--e-t1); }\n.e-g2 .x-mesa { font-size: 13px; color: var(--e-t3); }\n.e-g2 .x-atencao-bloco { display: grid; gap: 5px; padding: 10px 14px; border-left: 3px solid var(--e-aviso-borda); border-radius: 0 10px 10px 0; background: var(--e-aviso-fundo); }\n.e-g2 .x-ctrl { display: grid; gap: 6px; justify-items: start; }\n.e-g2 .x-ctrl-nome { font-size: 13.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .x-ctrl-linha { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }\n.e-g2 .x-custo { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; color: var(--e-t2); white-space: nowrap; }\n.e-g2 .x-rodape { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; padding-top: 12px; border-top: 1px solid var(--e-linha); font-size: 13.5px; color: var(--e-t2); }\n.e-g2 .x-rodape .x-regra { margin-left: auto; }\n.e-g2 .m-link svg { width: 15px; height: 15px; }\n.e-g2 .x-cartao-topo { display: flex; align-items: flex-start; gap: 12px; }\n.e-g2 .x-cartao-nome { margin: 0; font: 600 23px/1.1 var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .x-cartao-meta { margin: 5px 0 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; color: var(--e-t2); }\n.e-g2 .x-cartao-acoes { margin-left: auto; display: flex; align-items: center; gap: 6px; }\n\n/* Instruções em linguagem de jogo: quem faz (a ficha, com relógio ou raio; o jogador, com a mão) */\n.e-g2 .x-instrucao { display: inline-flex; align-items: flex-start; gap: 6px; font-size: 13.5px; line-height: 1.35; color: var(--e-t2); }\n.e-g2 .x-instrucao svg { flex: none; width: 14px; height: 14px; margin-top: 1px; color: var(--e-t3); }\n.e-g2 .x-instrucao[data-auto] svg { color: var(--e-t2); }\n.e-g2 .x-custo-jogo { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 13.5px; color: var(--e-t1); }\n.e-g2 .x-custo-jogo svg { flex: none; width: 14px; height: 14px; color: var(--e-t2); }\n.e-g2 .x-custo-jogo .g-link { padding: 0; }\n\n/* ---------- Ativos: seções, grade e a faixa do detalhe ---------- */\n.e-g2 .d-secao { margin: 18px 0 8px; font: 600 15px var(--e-display); font-stretch: semi-condensed; color: var(--e-t2); }\n.e-g2 .g2-vazio { margin: 24px 0; }\n/* `dense`: a faixa do detalhe vem logo depois do cartão aberto e ocupa a linha\n   inteira; os cartões seguintes voltam para a linha do cartão aberto. */\n.e-g2 .g-grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); grid-auto-flow: row dense; gap: 10px; align-items: stretch; }\n.e-g2 .d-exp { grid-column: 1 / -1; position: relative; display: grid; gap: 16px; margin: 2px 0 6px; padding: 16px 20px 14px; border: 1px solid var(--afty-destaque); border-radius: 14px; background: var(--e-painel); }\n.e-g2 .d-exp::before { content: \"\"; position: absolute; top: -8px; left: var(--seta, 40px); width: 14px; height: 14px; transform: rotate(45deg); border-left: 1px solid var(--afty-destaque); border-top: 1px solid var(--afty-destaque); background: var(--e-painel); }\n\n/* ---------- o cartão etiqueta ---------- */\n/* Altura fixa em toda a grade. A etiqueta tem largura fixa (o nome começa sempre\n   no mesmo lugar) e só existe quando há estado ou prazo. */\n.e-g2 .g2-cartao { display: grid; grid-template-columns: 166px minmax(0, 1fr); min-width: 0; height: 76px; padding: 0; border: 1px solid transparent; border-radius: 12px; background: color-mix(in oklab, var(--afty-card) 72%, var(--afty-fundo)); color: var(--e-t1); text-align: left; overflow: hidden; cursor: pointer; }\n.e-g2 .g2-cartao:hover { border-color: var(--e-ctrl-borda); }\n.e-g2 .g2-cartao[aria-current=\"true\"] { border-color: var(--afty-destaque); }\n.e-g2 .g2-cartao:focus-visible { outline: 2px solid var(--afty-destaque); outline-offset: 2px; }\n.e-g2 .g2-cartao[data-sem-etiqueta] { grid-template-columns: minmax(0, 1fr); }\n.e-g2 .g2-zona { min-width: 0; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 8px 12px 8px 14px; background: color-mix(in oklab, var(--afty-texto) 5.5%, transparent); border-right: 1px solid var(--e-linha); }\n.e-g2 .g2-cartao[aria-current=\"true\"] .g2-zona { background: var(--e-sel); }\n.e-g2 .g2-zs { display: flex; gap: 16px; min-width: 0; }\n.e-g2 .g2-z { display: grid; gap: 2px; min-width: 0; }\n.e-g2 .g2-z small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .g2-z b { font: 600 17px/1.1 var(--e-display); font-stretch: semi-condensed; font-variant-numeric: var(--e-num); }\n.e-g2 .g2-z b[data-linhas=\"1\"] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.e-g2 .g2-z b[data-linhas=\"2\"] { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }\n.e-g2 .g2-z .x-medidor { margin-top: 3px; }\n.e-g2 .g-tempo { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--e-t1); white-space: nowrap; }\n.e-g2 .g-tempo svg { width: 14px; height: 14px; color: var(--e-t2); }\n.e-g2 .g-tempo[data-mesa] { font-weight: 500; color: var(--e-t2); }\n.e-g2 .g2-zona .g-tempo { display: flex; align-items: center; gap: 5px; min-width: 0; line-height: 1.3; }\n.e-g2 .g2-zona .g-tempo svg { flex: none; }\n.e-g2 .g2-zona .g-tempo > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n/* O aviso no cartão usa a cor de destaque do tema; o âmbar fica no detalhe. */\n.e-g2 .g2-zona .g-tempo[data-atencao] svg { color: var(--afty-destaque); }\n.e-g2 .g2-conteudo { display: flex; flex-direction: column; justify-content: center; gap: 6px; min-width: 0; padding: 9px 14px; }\n.e-g2 .g2-nome { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 15.5px; font-weight: 600; line-height: 1.3; }\n\n/* ---------- o resultado de uma operação ---------- */\n.e-g2 .g2-resultado { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; padding: 10px 44px 10px 14px; border-radius: 10px; background: color-mix(in oklab, var(--afty-destaque) 9%, transparent); font-size: 14px; }\n.e-g2 .x-rola > .g2-resultado { margin: 4px 0 10px; }\n.e-g2 .g2-resultado[data-tom=\"nada\"] { background: var(--e-aviso-fundo); }\n.e-g2 .g2-resultado[data-tom=\"nada\"] .g2-resultado-verbo svg { color: var(--e-aviso-icone); }\n.e-g2 .g2-resultado-verbo { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--e-t1); }\n.e-g2 .g2-resultado-verbo svg { width: 15px; height: 15px; }\n.e-g2 .g2-resultado-x { position: absolute; top: 6px; right: 6px; }\n.e-g2 .g2-pv { display: grid; gap: 4px; }\n\n/* ---------- a Preparação e o ajuste ---------- */\n.e-g2 .k-sub { margin: 0; font: 600 13.5px var(--e-display); font-stretch: semi-condensed; color: var(--e-t3); }\n.e-g2 .g2-previa { display: grid; gap: 4px; }\n.e-g2 .g2-preparo { gap: 8px; }\n.e-g2 .g2-preparo-linha { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }\n/* Consolidação ampliada (2026-10-16): as opções de uma escolha (as vagas de Sustentação, com o nome de cada Feitiço) quebram linha quando não cabem\n   na coluna, em vez de passar por cima da coluna vizinha. Onde cabem, nada muda. */\n.e-g2 .g2-preparo .m-seg { flex-wrap: wrap; max-width: 100%; }\n.e-g2 .g2-ajuste { display: grid; gap: 8px; margin-top: 4px; }\n/* Catálogo, primeira entrega: as escolhas do rascunho (Concentrar Aura) quebram linha, como no g-controle. */\n.e-g2 .g2-rascunho-multi .m-seg { flex-wrap: wrap; }\n/* A escolha de um passo é sempre destacada, inclusive o primeiro (no estudo.css o\n   primeiro botão de um radio é \"Nenhum\", neutro). */\n.e-g2 .g2-escolha .m-seg-op { min-width: 40px; }\n.e-g2 .g2-escolha .m-seg-op[aria-checked=\"true\"] { background: color-mix(in oklab, var(--afty-destaque) 30%, transparent); color: var(--e-t1); box-shadow: inset 0 0 0 1px var(--e-sel-borda); }\n\n/* ---------- o catálogo do Adicionar ---------- */\n.e-g2 .k-catalogo { flex: 1; min-width: 0; min-height: 0; display: grid; grid-template-rows: auto auto minmax(0, 1fr); gap: 12px; padding: 16px 0 14px; }\n.e-g2 .k-catalogo[data-aba=\"externa\"] { grid-template-rows: auto minmax(0, 1fr); }\n.e-g2 .k-topo { display: flex; align-items: center; gap: 12px; }\n.e-g2 .k-topo > .m-seg { margin-left: auto; }\n.e-g2 .k-busca .afty-campo { height: 46px; font-size: 16px; }\n.e-g2 .k-corpo { min-height: 0; display: grid; grid-template-columns: 220px minmax(0, 540px) minmax(300px, 1fr); gap: 20px; }\n.e-g2 .k-trilho { min-height: 0; overflow: auto; display: grid; align-content: start; gap: 2px; }\n.e-g2 .k-cat { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 6px 12px; border: 0; border-radius: 9px; background: none; color: var(--e-t2); font-size: 14.5px; font-weight: 600; text-align: left; }\n.e-g2 .k-cat svg { width: 14px; height: 14px; color: var(--e-t2); }\n.e-g2 .k-cat small { margin-left: auto; font-size: 13px; font-weight: 500; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .k-cat:hover { background: var(--e-hover); color: var(--e-t1); }\n.e-g2 .k-cat[aria-current=\"true\"] { background: var(--e-sel); color: var(--e-t1); box-shadow: inset 3px 0 0 var(--afty-destaque); }\n.e-g2 .k-sep { height: 1px; margin: 6px 6px; background: var(--e-linha); }\n.e-g2 .k-lista { min-height: 0; overflow: auto; padding: 0 6px 24px 0; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .k-titulo-lista { margin: 4px 0 8px; font: 600 16px var(--e-display); font-stretch: semi-condensed; color: var(--e-t1); }\n.e-g2 .k-grupo { margin: 14px 0 6px; display: flex; align-items: baseline; gap: 8px; font: 600 13.5px var(--e-display); font-stretch: semi-condensed; color: var(--e-t3); }\n.e-g2 .k-grupo small { font: 400 13px var(--afty-fonte); }\n/* Toda opção tem a mesma altura: uma linha, nome e no máximo uma ação à direita. */\n.e-g2 .k-fila { display: flex; align-items: center; height: 44px; margin: 0 0 6px; border: 1px solid transparent; border-radius: 10px; background: color-mix(in oklab, var(--afty-card) 72%, var(--afty-fundo)); }\n.e-g2 .k-fila:hover { border-color: var(--e-ctrl-borda); }\n.e-g2 .k-fila[aria-current=\"true\"] { border-color: var(--afty-destaque); background: var(--e-sel); }\n.e-g2 .k-item { flex: 1; min-width: 0; align-self: stretch; display: flex; align-items: center; padding: 0 12px; border: 0; border-radius: 10px; background: none; color: var(--e-t1); text-align: left; }\n.e-g2 .k-nome { display: flex; align-items: center; gap: 8px; min-width: 0; font-size: 15px; font-weight: 600; line-height: 1.3; }\n.e-g2 .k-texto { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n/* Toda linha tem a estrela no mesmo lugar: cheia no favorito, vazia nos outros. */\n.e-g2 .k-fav { flex: none; display: inline-flex; width: 14px; height: 14px; color: var(--e-t3); }\n.e-g2 .k-fav svg { width: 14px; height: 14px; fill: none; }\n.e-g2 .k-fav[data-favorito] { color: var(--e-t2); }\n.e-g2 .k-fav[data-favorito] svg { fill: currentColor; }\n/* Ativar e Ativo: texto discreto à direita, numa área de mesma largura, com uma\n   coluna para o rótulo e outra para a seta (vazia em Ativar). */\n.e-g2 .k-acao { flex: none; align-self: stretch; width: 74px; display: grid; grid-template-columns: minmax(0, 1fr) 15px; align-items: center; column-gap: 2px; padding: 0 8px 0 10px; border: 0; border-radius: 0 10px 10px 0; background: none; color: var(--e-t2); font-size: 13.5px; font-weight: 500; line-height: 1; text-align: left; white-space: nowrap; }\n.e-g2 .k-acao-seta { display: flex; width: 15px; height: 15px; }\n.e-g2 .k-acao:hover { color: var(--e-t1); }\n.e-g2 .k-acao:hover .k-acao-texto { text-decoration: underline; text-underline-offset: 3px; }\n.e-g2 .k-acao:focus-visible { outline: 2px solid var(--afty-destaque); outline-offset: -3px; color: var(--e-t1); }\n.e-g2 .k-acao svg { width: 15px; height: 15px; }\n.e-g2 .k-detalhe { align-self: start; max-height: 100%; min-height: 0; overflow: auto; display: grid; gap: 14px; padding: 16px 18px 16px; border: 1px solid var(--e-sel-borda); border-radius: 12px; background: color-mix(in oklab, var(--afty-card) 72%, var(--afty-fundo)); }\n.e-g2 .k-detalhe[data-ativando] { border-color: var(--afty-destaque); }\n.e-g2 .k-detalhe .x-cartao-nome { font-size: 21px; }\n.e-g2 .k-confirmar { display: grid; gap: 10px; justify-items: start; padding: 12px 0; border-top: 1px solid var(--e-linha); border-bottom: 1px solid var(--e-linha); }\n.e-g2 .k-confirmar > .x-linha { justify-self: stretch; }\n.e-g2 .k-externa { min-height: 0; overflow: auto; max-width: 640px; }\n/* PACOTES PARA ALIADOS (2026-10-19): o suporte prepara e exporta (Para Aliados), o aliado importa e ativa (Recebidos, em Fonte Externa).\n   Mesmo leiaute do catálogo: trilha, lista de linhas de 44 px e detalhe. Só o que a peça nova pede. */\n.e-g2 .k-catalogo[data-aba=\"aliados\"] { grid-template-rows: auto minmax(0, 1fr); }\n.e-g2 .pa-cabeca { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 0 0 10px; }\n.e-g2 .pa-nome { flex: 1 1 220px; height: 38px; font-size: 15px; font-weight: 600; }\n.e-g2 .pa-busca { margin: 0 0 8px; }\n.e-g2 .pa-busca .afty-campo { height: 40px; font-size: 15px; }\n.e-g2 .pa-acoes { margin: 6px 0 0; }\n.e-g2 .pa-rodape { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 14px 0 8px; padding-top: 12px; border-top: 1px solid var(--e-linha); }\n.e-g2 .pa-excluir { margin-left: auto; }\n.e-g2 .pa-resumo { display: grid; gap: 12px; }\n.e-g2 .pa-bloco { display: grid; gap: 5px; justify-items: start; }\n.e-g2 .pa-icone { flex: none; width: 14px; height: 14px; color: var(--e-t3); }\n.e-g2 .pa-problema { flex: none; display: inline-flex; color: var(--e-aviso-icone); }\n.e-g2 .pa-problema svg { width: 14px; height: 14px; }\n.e-g2 .pa-emissor { display: block; margin: 10px 12px 2px; font-size: 12.5px; font-weight: 600; color: var(--e-t3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.e-g2 .pa-manual { display: grid; gap: 10px; padding: 12px 0 0; border-top: 1px solid var(--e-linha); }\n.e-g2 .pa-beneficio { flex-wrap: wrap; }\n.e-g2 .pa-colar { height: auto; min-height: 84px; padding: 8px 10px; font-size: 12.5px; line-height: 1.4; resize: vertical; }\n.e-g2 .pa-importar { display: grid; gap: 12px; align-content: start; }\n.e-g2 .k-acao[data-tom=\"consulta\"] { color: var(--e-t3); }\n/* \"Incluído\", \"Consulta\" e \"Sem Efeito\" são mais largos que Ativar e Ativo: a coluna da ação cresce sem empurrar o nome. */\n.e-g2 .k-acao[data-largo] { width: 104px; }\n.e-g2 .k-cat:disabled { opacity: .55; }\n\n/* ---------- G2 · painel compacto (PRÉVIA, &compacta=g2) ---------- */\n/* A hierarquia do G2 na largura do painel: lista de itens de altura única\n   (nome em cima, estado curto e prazo embaixo) ou um efeito por vez. */\n.e-g2 .c2-filtro { flex: none; display: flex; gap: 2px; margin: 10px 4px 6px 14px; }\n.e-g2 .c2-filtro .m-seg-op { flex: 1 1 auto; min-width: 0; padding: 0 6px; font-size: 12.5px; }\n.e-g2 .c2-filtro .m-seg-op small { margin-left: 4px; font-size: 12.5px; font-weight: 500; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .c2-corpo { flex: 1; min-height: 0; overflow: auto; padding: 2px 4px 16px 14px; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .c2-corpo > .g2-resultado { margin: 4px 0 8px; }\n.e-g2 .c2-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }\n.e-g2 .c2-divisao { margin: 10px 0 0; font: 600 12.5px var(--e-display); font-stretch: semi-condensed; color: var(--e-t3); letter-spacing: .02em; }\n.e-g2 .c2-item { width: 100%; height: 58px; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: center; column-gap: 8px; row-gap: 2px; padding: 0 10px 0 12px; border: 1px solid transparent; border-radius: 10px; background: color-mix(in oklab, var(--afty-card) 72%, var(--afty-fundo)); color: var(--e-t1); text-align: left; cursor: pointer; }\n.e-g2 .c2-item:hover { border-color: var(--e-ctrl-borda); }\n.e-g2 .c2-item:focus-visible { outline: 2px solid var(--afty-destaque); outline-offset: 1px; }\n.e-g2 .c2-nome { grid-column: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 600; line-height: 1.3; }\n.e-g2 .c2-sub { grid-column: 1; min-width: 0; display: flex; align-items: center; gap: 10px; font-size: 13px; line-height: 1.3; color: var(--e-t2); }\n.e-g2 .c2-estado { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.e-g2 .c2-sub .g-tempo { flex: none; font-size: 13px; }\n.e-g2 .c2-sub .g-tempo svg { width: 13px; height: 13px; }\n/* O aviso do prazo no item usa a cor de destaque do tema, como no cartão. */\n.e-g2 .c2-sub .g-tempo[data-atencao] svg { color: var(--afty-destaque); }\n.e-g2 .c2-seta { grid-column: 2; grid-row: 1 / span 2; align-self: center; width: 16px; height: 16px; color: var(--e-t3); }\n.e-g2 .c2-vazio { margin: 16px 0; }\n.e-g2 .c2-detalhe { flex: 1; min-height: 0; display: flex; flex-direction: column; }\n.e-g2 .c2-det-topo { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 4px 6px 14px; }\n.e-g2 .c2-det-corpo { flex: 1; min-height: 0; overflow: auto; display: grid; align-content: start; gap: 14px; padding: 4px 4px 20px 14px; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .c2-det-nome { margin: 0; font: 600 21px/1.15 var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .c2-det-corpo > .x-cartao-meta { margin: -8px 0 0; font-size: 13.5px; }\n.e-g2 .c2-det-corpo > .x-col { padding-top: 10px; border-top: 1px solid var(--e-linha); }\n.e-g2 .c2-det-corpo .x-rodape { gap: 6px 14px; }\n.e-g2 .c2-det-corpo .x-rodape .x-regra { margin-left: 0; }\n.e-g2 .c2-rodape { justify-content: flex-start; }\n.e-g2 .c2-adicionar { margin-left: 0; }\n\n/* ---------- G2 · Encerrados nesta sessão e Reativar ---------- */\n/* Acesso discreto ao pé dos Ativos (completa) e da lista (painel), recolhido ao entrar. */\n.e-g2 .e2-encerrados { margin: 22px 0 0; border-top: 1px solid var(--e-linha); padding-top: 10px; }\n.e-g2 .c2-corpo .e2-encerrados { margin-top: 16px; }\n.e-g2 .e2-toggle { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 8px 0 4px; border: 0; border-radius: 8px; background: none; color: var(--e-t2); font: 600 14px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .e2-toggle:hover { background: var(--e-hover); color: var(--e-t1); }\n.e-g2 .e2-toggle small { margin-left: 4px; font: 500 13px var(--afty-fonte); color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .e2-seta { width: 15px; height: 15px; transition: transform .15s; }\n.e-g2 .e2-toggle[aria-expanded=\"true\"] .e2-seta { transform: rotate(90deg); }\n.e-g2 .e2-lista { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; max-width: 760px; }\n.e-g2 .e2-item { border: 1px solid transparent; border-radius: 10px; background: color-mix(in oklab, var(--afty-card) 60%, var(--afty-fundo)); }\n.e-g2 .e2-item:has([data-reativando], [data-ativando]) { border-color: var(--afty-destaque); }\n.e-g2 .e2-linha { display: flex; align-items: center; min-height: 44px; }\n.e-g2 .e2-nome { flex: 1; min-width: 0; padding: 0 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14.5px; font-weight: 600; color: var(--e-t2); }\n.e-g2 .e2-reativar { width: auto; display: inline-flex; gap: 6px; padding: 0 12px 0 10px; }\n.e-g2 .e2-reativar svg { width: 14px; height: 14px; }\n.e-g2 .e2-item > .k-confirmar { margin: 0 12px 12px; padding-top: 10px; border-bottom: 0; }\n.e-g2 .e2-volta { color: var(--e-t1); font-weight: 600; }\n\n/* ---------- G2 · Linha do Tempo funcional (portada do modelo estático, com faixas) ---------- */\n.e-g2 .lt-painel { margin: 0 0 4px; padding: 4px 12px 6px; border: 1px solid var(--e-painel-borda); border-radius: 14px; background: var(--e-painel); }\n.e-g2 .lt-linha { display: grid; grid-template-columns: 190px repeat(4, minmax(0, 1fr)); align-items: start; min-height: 31px; border-top: 1px solid var(--e-linha); }\n.e-g2 .lt-linha.lt-cab { border-top: 0; min-height: 24px; align-items: end; }\n.e-g2 .lt-cab-nome, .e-g2 .lt-cab-r { padding: 0 8px 3px; font: 600 13.5px var(--e-display); font-stretch: semi-condensed; color: var(--e-t3); white-space: nowrap; }\n.e-g2 .lt-cab-r[data-agora] { color: var(--e-t1); }\n.e-g2 .lt-cab-r small { margin-left: 6px; font: 600 12.5px var(--afty-fonte); color: var(--e-t2); }\n/* Faixas: toda célula começa no mesmo ponto, com uma faixa só. */\n.e-g2 .lt-nome { align-self: start; min-height: 32px; display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 3px 8px; border: 0; border-radius: 8px; background: none; color: var(--e-t1); text-align: left; font-size: 14px; font-weight: 600; line-height: 1.25; cursor: pointer; }\n.e-g2 .lt-nome:disabled { cursor: default; }\n.e-g2 .lt-nome-texto { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.e-g2 .lt-nome small { font-size: 12.5px; font-weight: 500; color: var(--e-t3); }\n.e-g2 .lt-nome:hover:not(:disabled) { background: var(--e-hover); }\n.e-g2 .lt-linha[data-marcada] { border-radius: 8px; background: var(--e-sel); box-shadow: inset 3px 0 0 var(--afty-destaque); }\n.e-g2 .lt-celula { align-self: stretch; display: flex; flex-direction: column; justify-content: flex-start; gap: 2px; min-width: 0; padding: 5px 0; border-left: 1px dashed var(--e-linha); }\n.e-g2 .lt-celula[data-agora] { background: color-mix(in oklab, var(--afty-texto) 3%, transparent); }\n.e-g2 .lt-seg { display: flex; align-items: center; height: 22px; padding: 0 10px; background: color-mix(in oklab, var(--afty-texto) 16%, transparent); font-size: 13px; font-weight: 600; color: var(--e-t1); white-space: nowrap; overflow: hidden; cursor: pointer; }\n.e-g2 .lt-seg[data-ini] { margin-left: 5px; border-radius: 6px 0 0 6px; }\n.e-g2 .lt-seg[data-fim] { margin-right: 5px; border-radius: 0 6px 6px 0; }\n.e-g2 .lt-seg[data-ini][data-fim] { border-radius: 6px; }\n.e-g2 .lt-seg[data-mantido] { background: repeating-linear-gradient(135deg, color-mix(in oklab, var(--afty-texto) 9%, transparent) 0 7px, transparent 7px 12px); color: var(--e-t2); font-weight: 500; }\n/* A faixa: barra e marcadores na mesma altura. Um aviso nunca aumenta a linha.\n   O marcador do começo da rodada fica à esquerda, o do fim à direita, e a barra\n   reserva o lugar deles (--m-ini e --m-fim) para o contador não passar por baixo. */\n.e-g2 .lt-faixa { position: relative; display: block; height: 22px; }\n.e-g2 .lt-seg { padding-left: calc(10px + var(--m-ini, 0) * 21px); padding-right: calc(10px + var(--m-fim, 0) * 21px); }\n/* Sem espaço, encolhe o \"Se Mantido\" e o contador fica inteiro. */\n.e-g2 .lt-seg-texto { display: flex; min-width: 0; overflow: hidden; }\n.e-g2 .lt-seg-pre { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: pre; }\n.e-g2 .lt-seg-valor { flex: none; }\n.e-g2 .lt-pinos { position: absolute; top: 2px; display: flex; gap: 3px; }\n.e-g2 .lt-pinos[data-lado=\"inicio\"] { left: 7px; }\n.e-g2 .lt-pinos[data-lado=\"fim\"] { right: 7px; }\n/* Aviso operacional na cor do tema (roxo). A manutenção opcional fica neutra. */\n.e-g2 .lt-pino { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; padding: 0; border: 1px solid var(--e-aviso-borda); border-radius: 5px; background: color-mix(in oklab, var(--afty-card) 82%, var(--afty-destaque)); color: var(--e-aviso-icone); cursor: help; }\n.e-g2 .lt-pino svg { width: 12px; height: 12px; }\n.e-g2 .lt-pino:hover, .e-g2 .lt-pino[aria-expanded=\"true\"] { border-color: var(--afty-destaque); background: color-mix(in oklab, var(--afty-card) 62%, var(--afty-destaque)); }\n.e-g2 .lt-pino[data-tom=\"opcional\"] { border-color: color-mix(in oklab, var(--afty-texto) 22%, transparent); background: var(--afty-card); color: var(--e-t2); }\n.e-g2 .lt-pino[data-tom=\"opcional\"]:hover, .e-g2 .lt-pino[data-tom=\"opcional\"][aria-expanded=\"true\"] { border-color: color-mix(in oklab, var(--afty-texto) 45%, transparent); background: var(--e-hover); }\n/* A explicação: posição fixa, fora do fluxo da grade (não muda altura nenhuma). */\n.e-g2 .lt-dica { position: fixed; z-index: 60; width: max-content; max-width: min(300px, calc(100vw - 16px)); padding: 9px 11px 10px; border: 1px solid var(--e-painel-borda); border-radius: 10px; background: var(--afty-card); box-shadow: 0 14px 30px -8px rgb(0 0 0 / .7); font-size: 13px; line-height: 1.35; color: var(--e-t1); text-align: left; white-space: normal; }\n.e-g2 .lt-dica[data-tom=\"atencao\"] { border-color: var(--e-aviso-borda); }\n.e-g2 .lt-dica-titulo { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; font-weight: 600; }\n.e-g2 .lt-dica-titulo svg { width: 14px; height: 14px; color: var(--e-t3); }\n.e-g2 .lt-dica[data-tom=\"atencao\"] .lt-dica-titulo { color: var(--e-aviso); }\n.e-g2 .lt-dica[data-tom=\"atencao\"] .lt-dica-titulo svg { color: var(--e-aviso-icone); }\n.e-g2 .lt-dica-campos { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 3px 12px; margin: 0; }\n.e-g2 .lt-dica-campos dt { font-size: 12.5px; color: var(--e-t3); }\n.e-g2 .lt-dica-campos dd { margin: 0; }\n.e-g2 .lt-dica-nota { display: block; margin-top: 6px; font-size: 12.5px; color: var(--e-t2); }\n\n/* ---------- Fechamento do G2 (2026-10-16): a largura que o painel dá é a que o conteúdo usa ---------- */\n/* A CAUSA do vazamento (G2-E8-1): cada contêiner abaixo é um `display: grid` sem trilha declarada, e a trilha implícita é `auto`. Uma trilha\n   `auto` cresce até o tamanho mínimo do conteúdo, e um resumo `nowrap` (o custo do Golpe Especial) empurrou a Preparação a 661 px dentro de uma\n   coluna de 361 px, por cima de Termina, de Agora e do Confirmar. Com `minmax(0, 1fr)` a trilha é a do painel, e o conteúdo quebra linha nela. */\n.e-g2 :is(.x-col, .x-atencao-bloco, .x-ctrl, .d-exp, .g2-pv, .g2-previa, .g2-ajuste, .k-detalhe, .k-confirmar, .c2-det-corpo) { grid-template-columns: minmax(0, 1fr); }\n/* O que o Ajustar e a Fonte Externa desenham com as peças do gerenciador (`gestor.css`) mora nos mesmos painéis. */\n.e-g2 :is(.d-exp, .c2-det-corpo, .k-detalhe, .e2-item) :is(.g-controles, .g-controle, .g-registro, .g-campo, .g-previa) { grid-template-columns: minmax(0, 1fr); }\n/* Texto de custo quebra linha. As partes do resumo do Golpe não se partem no meio (\"Atroz +1\" fica junto). */\n.e-g2 .x-custo { white-space: normal; text-wrap: pretty; }\n.e-g2 .g2-parte { white-space: nowrap; }\n/* Toda escolha em segmentos, onde estiver no painel, quebra linha em vez de passar da coluna. */\n.e-g2 :is(.d-exp, .c2-det-corpo, .k-detalhe, .e2-item) .m-seg { flex-wrap: wrap; max-width: 100%; }\n/* O resumo do Golpe é texto corrido: em `inline-flex` cada parte virava um item da mesma linha e nada quebrava. */\n.e-g2 .x-custo[data-golpe-partes] { display: block; }\n\n/* ========== FECHAMENTO (estudo/fechamento.css) ========== */\n/* ============================================================\n   FECHAMENTO DO G2 (2026-10-16): o Histórico sob demanda e as estatísticas do cabeçalho configuráveis\n   ============================================================\n   Mesmos tokens do estudo (`--e-*`). Nada daqui desenha um bloco aberto na entrada de Habilidades ou de Efeitos: o acesso ao Histórico é um botão de\n   texto ao pé dos Ativos, e os dois painéis são flutuantes, abertos sob demanda.\n   ============================================================ */\n\n/* ---------- o acesso ao Histórico, ao pé dos Ativos (completa) e da lista do painel (compacta) ---------- */\n.e-g2 .h-acesso { margin: 6px 0 0; }\n.e-g2 .x-rola > .h-acesso { margin-top: 10px; }\n.e-g2 .e2-encerrados + .h-acesso { margin-top: 2px; }\n.e-g2 .h-acesso .e2-toggle svg { width: 15px; height: 15px; }\n.e-g2 .h-acesso .e2-toggle small { margin-left: 4px; font: 500 13px var(--afty-fonte); color: var(--e-t3); font-variant-numeric: var(--e-num); }\n\n/* ---------- o painel do Histórico ---------- */\n.e-g2 .h-hist-painel { padding: 0; }\n.e-g2 .h-hist { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 10px 12px 12px; }\n.e-g2 .h-hist-topo { display: flex; align-items: center; gap: 8px; }\n.e-g2 .h-hist-topo > svg { flex: none; width: 17px; height: 17px; color: var(--e-t2); }\n.e-g2 .h-hist-topo h2 { flex: 1; min-width: 0; margin: 0; display: flex; align-items: baseline; gap: 8px; font: 600 17px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .h-hist-topo h2 small { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 400 13px var(--afty-fonte); color: var(--e-t3); }\n.e-g2 .h-hist-filtros { display: flex; flex-wrap: wrap; max-width: 100%; justify-self: start; }\n.e-g2 .h-hist-filtros .m-seg-op { height: 28px; padding: 0 9px; font-size: 13px; }\n.e-g2 .h-hist-filtros .m-seg-op small { margin-left: 5px; font-weight: 500; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .h-hist-lista { list-style: none; margin: 0; padding: 0 4px 0 0; max-height: min(56vh, 460px); overflow: auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; scrollbar-width: thin; scrollbar-color: var(--e-ctrl-borda) transparent; }\n.e-g2 .h-hist-item { display: grid; grid-template-columns: 78px minmax(0, 1fr) auto; align-items: start; gap: 4px 10px; padding: 8px 8px 8px 10px; border-radius: 9px; background: color-mix(in oklab, var(--afty-card) 72%, var(--afty-fundo)); }\n.e-g2 .h-hist-item[data-estornado] { opacity: .72; }\n.e-g2 .h-hist-meta { display: grid; gap: 1px; font-size: 12.5px; color: var(--e-t3); font-variant-numeric: var(--e-num); }\n.e-g2 .h-hist-meta b { font-weight: 700; color: var(--e-t2); }\n.e-g2 .h-hist-texto { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; min-width: 0; font-size: 14px; line-height: 1.35; color: var(--e-t1); overflow-wrap: anywhere; }\n.e-g2 .h-hist-origem { font-size: 12.5px; color: var(--e-t3); }\n.e-g2 .h-hist-origem b { color: var(--e-t2); }\n.e-g2 .h-hist-limites { list-style: none; margin: 2px 0 0; padding: 0; display: grid; gap: 2px; font-size: 12.5px; color: var(--e-t2); }\n.e-g2 .h-hist-limites li { display: flex; align-items: flex-start; gap: 5px; }\n.e-g2 .h-hist-limites svg { flex: none; width: 13px; height: 13px; margin-top: 2px; color: var(--e-aviso-icone); }\n.e-g2 .h-hist-acao { height: 28px; padding: 0 9px; font-size: 13px; white-space: nowrap; }\n.e-g2 .h-hist-acao svg { width: 14px; height: 14px; }\n.e-g2 .h-hist-acao:disabled { color: var(--e-t3); cursor: default; }\n.e-g2 .h-hist-vazio { padding: 14px 4px; font-size: 14px; color: var(--e-t3); }\n\n/* ---------- as estatísticas do cabeçalho ---------- */\n.e-g2 .h-estat-painel { padding: 10px 12px 12px; }\n.e-g2 .h-estat { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }\n.e-g2 .h-estat-topo { font: 600 16px var(--e-display); font-stretch: semi-condensed; }\n.e-g2 .h-estat-lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; max-height: min(58vh, 460px); overflow: auto; }\n.e-g2 .h-estat-linha { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 2px 0 8px; border-radius: 9px; }\n.e-g2 .h-estat-linha:hover, .e-g2 .h-estat-linha:focus-within { background: var(--e-hover); }\n.e-g2 .h-estat-linha[data-visivel=\"nao\"] .h-estat-nome span { color: var(--e-t3); }\n.e-g2 .h-estat-nome { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 600; cursor: pointer; }\n.e-g2 .h-estat-nome input { flex: none; width: 17px; height: 17px; accent-color: var(--afty-destaque); }\n.e-g2 .h-estat-setas { flex: none; display: inline-flex; gap: 2px; }\n.e-g2 .h-estat-setas .e-icone { width: 32px; height: 32px; }\n.e-g2 .h-estat-setas .e-icone svg { width: 16px; height: 16px; }\n.e-g2 .h-estat-setas .e-icone:disabled { opacity: .35; }\n.e-g2 .h-estat-rodape { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-top: 6px; border-top: 1px solid var(--e-linha); }\n.e-g2 .h-estat-abrir { margin-top: 8px; }\n\n/* ---------- o aviso de texto não segura o ponteiro ---------- */\n/* O aviso de uma recusa (\"Faltam 4 PE\") fica 4 s no centro de baixo e é só texto: por cima de um Confirmar rolado até o pé, ele não pode comer o clique. O\n   aviso da rolagem tem um botão (Rolar de Novo) e continua clicável. */\n.e-g2 .m-aviso-flutuante:not(:has(button)) { pointer-events: none; }\n\n\n/* ========== INTEGRAÇÃO NA FICHA ==========\n   A Ficha rola pela JANELA, com o cabeçalho grudado no topo. O estudo era uma grade de altura da tela com rolagens internas. Aqui:\n     - o ESTÁGIO (Habilidades e a aba Efeitos) tem a altura da tela abaixo do cabeçalho, e as listas rolam por dentro, como no estudo;\n     - as outras abas seguem rolando pela janela, e o painel compacto, quando aberto, fica grudado ao lado delas;\n     - a consulta é uma gaveta FIXA à direita, abaixo do cabeçalho, e cobre o Confirmar enquanto está aberta (Esc ou Fechar a dispensam).\n   `--afty-ficha-topo` é a altura do cabeçalho grudado, medida pela Ficha (`AftyFicha.jsx`). */\n.e-layout { display: flex; align-items: flex-start; --e-painel-w: 0px; --e-trilho: 72px; }\n.e-layout[data-painel] { --e-painel-w: 390px; --e-trilho: 0px; }\n@media (min-width: 1400px) { .e-layout[data-painel] { --e-painel-w: 428px; } }\n/* `--e-trilho` é a trilha do botão dos Livros (canto de baixo, à direita): nada do estágio passa por baixo dele. Com o painel ao lado a trilha é do painel. */\n.e-layout > .e-coluna { flex: 1; min-width: 0; }\n.e-layout > .e-lado { flex: none; position: sticky; top: var(--afty-ficha-topo, 0px); align-self: flex-start; height: calc(100dvh - var(--afty-ficha-topo, 0px)); display: flex; }\n.e-layout > .e-lado > .g-painel { height: 100%; }\n.e-coluna > main[data-estagio] { padding-top: 0; padding-bottom: 0; }\n.e-g2.e-portal { display: contents; }\n.e-g2 .e-area { margin-right: var(--e-trilho, 0px); }\n.e-g2 .e-consulta {\n  position: fixed; z-index: 30; top: calc(var(--afty-ficha-topo, 0px) + 10px); bottom: 14px; right: calc(var(--e-painel-w, 0px) + var(--e-trilho, 0px) + 16px);\n  width: min(580px, calc((100vw - var(--e-painel-w, 0px)) * .47));\n}\n.e-layout[data-painel] ~ .e-portal .e-consulta, .e-layout[data-painel] .e-portal .e-consulta { width: min(560px, calc((100vw - var(--e-painel-w, 0px)) * .62)); }\n.e-g2 .e-cabeca { margin: 10px 0 0; }\n.e-g2 .m-pv-fonte { display: flex; justify-content: space-between; gap: 18px; padding: 3px 0; color: var(--e-t2); }\n.e-g2 .m-pv-fonte b { font-weight: 600; color: var(--e-t1); font-variant-numeric: var(--e-num); }\n.e-g2 .afty-fontes-titulo { font-weight: 700; margin-bottom: 6px; }\n.e-g2 .afty-fontes-vazio { color: var(--e-t3); }\n.e-g2 .afty-fontes-lista { min-width: 220px; font-size: 13.5px; }\n.e-g2 .e-linhagem-aviso { width: 13px; height: 13px; margin-right: 4px; vertical-align: -2px; color: var(--e-aviso-icone); }\n.e-g2 .e-linha .e-aviso { display: inline-flex; align-items: center; color: var(--e-aviso-icone); }\n.e-g2 .e-linha .e-aviso svg { width: 14px; height: 14px; }\n.e-troca-apresentacao { display: flex; justify-content: flex-end; padding: 4px 0 6px; }\n.e-g2 .e-placa { grid-template-columns: auto auto minmax(0, 1fr) auto auto; column-gap: 14px; }\n.e-g2 .e-voltar { align-self: center; margin-right: -4px; }\n.e-g2 .e-controles { display: flex; align-items: center; gap: 4px; align-self: start; }\n.e-g2 .e-controles .afty-botao { height: 36px; min-width: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 9px; border: 0; background: none; color: var(--e-t2); }\n.e-g2 .e-controles .afty-botao:hover { background: var(--e-ctrl); color: var(--e-t1); }\n/* O `.afty-retrato` da Ficha é a peça vertical do cabeçalho antigo (posição absoluta que preenche a moldura). Aqui ele mora dentro da moldura redonda. */\n.e-g2 .e-moldura { position: relative; flex: none; }\n.e-g2 .e-retrato, .e-g2 .m-retrato-vazio { position: static; inset: auto; }\n/* As estatísticas do cabeçalho do G2 são uma fileira de rótulo e valor na mesma linha. O `.afty-stat` da Ficha é a célula em caixa (rótulo em cima, valor embaixo):\n   aqui só o necessário é desfeito, e um tema que pinta `.afty-stat` (fundo, borda, cor) continua mandando, por ter mais especificidade. */\n.e-g2 .e-stat { display: inline-flex; flex-direction: row; align-items: baseline; justify-content: flex-start; gap: 6px; min-height: 0; padding: 0; border: 0; border-radius: 0; background: none; }\n.e-g2 .e-stat dt.afty-stat-rotulo { display: inline; max-width: none; font-size: 12.5px; line-height: inherit; text-transform: none; letter-spacing: 0; color: var(--afty-texto-fraco); overflow: visible; }\n/* O `index.css` do app fixa a cor dos h1 e h2 (#f3f4f6, o app é sempre escuro) sem camada, e isso vence a herança que o estudo usava. Os títulos dos Efeitos\n   herdam a cor do tema, como o resto. */\n.e-g2 :is(h1, h2, h3) { color: inherit; }\n\n/* ---------- a placa em larguras menores ----------\n   Uma fileira só quando cabe (identidade, recursos, controles). Abaixo de 1180 px os recursos descem para uma segunda fileira que divide a largura\n   toda, e abaixo de 720 px a identidade também ganha fileira própria. A faixa de baixo (valores e Agora) quebra no mesmo ponto. */\n.e-g2 .e-voltar { grid-area: voltar; }\n.e-g2 .e-moldura { grid-area: moldura; }\n.e-g2 .e-ident { grid-area: ident; }\n.e-g2 .e-recursos { grid-area: recursos; }\n.e-g2 .e-controles { grid-area: controles; }\n.e-g2 .e-placa { grid-template-areas: \"voltar moldura ident recursos controles\"; }\n@media (max-width: 1180px) {\n  .e-g2 .e-placa { grid-template-columns: auto auto minmax(0, 1fr) auto; grid-template-areas: \"voltar moldura ident controles\" \"recursos recursos recursos recursos\"; row-gap: 12px; }\n  .e-g2 .e-recursos { flex-wrap: wrap; }\n  .e-g2 .e-recursos > .m-medidor { flex: 1 1 140px; width: auto; min-width: 0; }\n  .e-g2 .e-faixa { flex-wrap: wrap; row-gap: 4px; }\n  .e-g2 .e-agora { margin-left: auto; padding-left: 0; border-left: 0; min-height: 44px; }\n  .e-g2 .e-stats { flex: 1 1 320px; }\n}\n@media (max-width: 720px) {\n  .e-g2 .e-cabeca { padding: 10px 10px 0; border-radius: 14px; }\n  .e-g2 .e-placa { grid-template-columns: auto auto minmax(0, 1fr); grid-template-areas: \"voltar moldura controles\" \"ident ident ident\" \"recursos recursos recursos\"; column-gap: 8px; row-gap: 8px; padding-bottom: 8px; }\n  .e-g2 .e-controles { justify-self: end; }\n  .e-g2 .e-moldura { width: 56px; height: 56px; }\n  .e-g2 .e-retrato { width: 50px; height: 50px; }\n  .e-g2 .e-nome { font-size: 22px; }\n  .e-g2 .e-recursos > .m-medidor { flex: 1 1 calc(50% - 6px); }\n  .e-g2 .e-agora { width: 100%; justify-content: space-between; margin-left: 0; }\n  .e-g2 .e-agora-rotulo { display: none; }\n}\n"]],[[5,29]],["BODY",{},[[5,30]],["DIV",{"id":"root"},["DIV",{"class":"min-h-screen flex flex-col"},["DIV",{"class":"flex-1"},["DIV",{"class":"afty-ficha","id":"afty-ficha","data-afty-densidade":"confortavel","style":"--afty-ficha-topo: 262px;"},["STYLE",{},"#afty-ficha {\n  --afty-fundo: #060910;\n  --afty-card: #0f172a;\n  --afty-poco: #020617;\n  --afty-borda: #1e293b;\n  --afty-texto: #f1f5f9;\n  --afty-texto-suave: #94a3b8;\n  --afty-destaque: #a855f7;\n  --afty-destaque-texto: #d8b4fe;\n  --afty-pv: #f43f5e;\n  --afty-pe: #38bdf8;\n  --afty-alma: #e879f9;\n  --afty-cura: #34d399;\n  --afty-aviso: #fbbf24;\n}"],["HEADER",{"class":"afty-cabecalho","style":"--afty-cabecalho-recolhido: 157px;"},["DIV",{"class":"max-w-7xl mx-auto px-3 sm:px-4"},["DIV",{"class":"e-g2"},["DIV",{"class":"e-cabeca afty-cabecalho"},["DIV",{"class":"e-placa"},["BUTTON",{"type":"button","class":"afty-botao e-icone e-voltar","aria-label":"Voltar"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-left ","aria-hidden":"true"},["path",{"d":"m15 18-6-6 6-6"}]]],["DIV",{"class":"e-moldura"},["SPAN",{"class":"afty-retrato m-retrato m-retrato-vazio e-retrato","aria-hidden":"true"},"Y("]],["DIV",{"class":"e-ident"},["H1",{"class":"afty-nome e-nome"},"Yuki (Teste Pacotes)"],["P",{"class":"e-linhagem"},["SPAN",{"class":"e-classe","title":"Suporte 10 · Controlador 4"},"Suporte"],["SPAN",{},"Nível 14"],["SPAN",{"title":"Grau do Feiticeiro, que vem do Nível"},"Primeiro Grau"]]],["DIV",{"class":"e-recursos"},["BUTTON",{"type":"button","class":"afty-vital m-medidor ","data-afty-vital":"pv","data-afty-nivel":"normal","data-recurso":"pv","aria-label":"Vida: 75 de 75. Abrir painel"},["SPAN",{"class":"m-medidor-topo"},["SPAN",{"class":"afty-vital-rotulo m-medidor-rotulo"},"Vida"],["SPAN",{"class":"m-m