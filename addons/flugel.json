                      "alvo": "atletismo",
                      "expr": "1"
                    }
                  ]
                },
                {
                  "id": "akutame_mestre_feiticaria",
                  "nome": "Feitiçaria",
                  "efeitos": [
                    {
                      "canal": "proficienciaPericia",
                      "alvo": "feiticaria",
                      "expr": "1"
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "talento_akutame",
            "nome": "Talento Akutame",
            "descricao": "Suas capacidades em um combate são superiores que qualquer outro ser, recebendo Acerto e Defesa em um valor igual à metade do seu Bônus de Treinamento."
          }
        ],
        "efeitos": [
          {
