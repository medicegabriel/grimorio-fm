    "clas": [
      {
        "id": "cla_akutame",
        "nome": "Clã Akutame",
        "lore": "Os Akatume são uma família antiga é muito importante para a sociedade, formados por exímios combatentes e conhecidos no manuseio de espadas e diversos tipos de lâminas, sendo considerados como o ápice máximo na prática de esgrima, também sendo conhecidos por abrigar uma vez por geração aquele chamado \"Santo da Espada\" devido a uma Benção milenar e muito poderosa que existe dentro da família. O Clã Akutame é um clã vassalo ao clã Sugawara, vindo com",
        "caracteristicas": [
          {
            "id": "bonus_atributo",
            "nome": "Bônus de atributo",
            "descricao": "Membros dessa família são conhecidos por terem corpos que passam do limite natural de qualquer humano, sendo considerados o ápice do desenvolvimento físico do mundo, recebem 3 pontos de atributo para distribuir entre seus atributos, com limite de 2 em um mesmo.",
            "bonus": {
              "distribuir": 3,
              "maxPorAtributo": 2
            }
          },
          {
            "id": "treinamento_de_cla",
            "nome": "Treinamento de clã",
            "descricao": "Devido ao imenso conhecimento em combate da sua família, você se tornou um exímio combatente mesmo em uma idade bem jovem, recebendo treinamento em Atletismo e Feitiçaria, se tornando mestre em um desses testes no nível 10.",
            "escolha": {
              "id": "akutame_mestre",
              "label": "Perícia",
              "ndMin": 10,
              "opcoes": [
                {
                  "id": "akutame_mestre_atletismo",
                  "nome": "Atletismo",
                  "efeitos": [
                    {
