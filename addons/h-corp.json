                "destreza",
                "constituicao"
              ],
              "maxPorAtributo": 2
            }
          },
          {
            "id": "hcorp_zodiaco",
            "nome": "Zodíaco",
            "descricao": "Você escolhe um animal do Zodíaco Chinês durante a criação. Uma vez por cena, você pode como Ação Livre aumentar um Atributo para 30 por três rodadas. Caso ele já esteja em 30, quebra o limite chegando em 32.",
