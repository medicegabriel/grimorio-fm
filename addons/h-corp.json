                  {
                    "id": "hcorp_zodiaco_rato",
                    "nome": "Rato (Inteligência)",
                    "descricao": "Astuto e engenhoso, o Rato acha a saída que ninguém viu. O Zodíaco aumenta a sua Inteligência.",
                    "efeitos": [
                      {
                        "canal": "limiteAtributo",
                        "alvo": "inteligencia",
                        "expr": "10",
                        "quando": "h_corp_zodiaco",
                        "duracao": "temporaria",
                        "nome": "Zodíaco: Rato"
                      },
                      {
                        "canal": "limiteAtributo",
                        "alvo": "inteligencia",
                        "expr": "2 * (inteligencia >= 30)",
                        "furaTeto": true,
                        "quando": "h_corp_zodiaco",
                        "duracao": "temporaria",
                        "nome": "Zodíaco: Rato"
                      },
                      {
                        "canal": "atributo",
                        "alvo": "inteligencia",
                        "expr": "max(30 - inteligencia, 0) + 2 * (inteligencia >= 30)",
