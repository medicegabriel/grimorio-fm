      {
        "id": "tal_zodiaco",
        "nome": "Zodíaco",
        "grupo": "geral",
        "descricao": "Você escolhe um animal do Zodíaco Chinês durante a criação. Uma vez por cena, você pode como Ação Livre aumentar um Atributo para 30 por três rodadas. Caso ele já esteja em 30, quebra o limite chegando em 32.",
        "escolha": {
          "id": "hct_zodiaco_animal",
          "label": "Animal do Zodíaco",
          "opcoes": [
            {
              "id": "hct_zodiaco_rato",
              "nome": "Rato (Inteligência)",
              "descricao": "Astuto e engenhoso, o Rato acha a saída que ninguém viu. O Zodíaco aumenta a sua Inteligência.",
              "efeitos": [
                {
                  "canal": "limiteAtributo",
                  "alvo": "inteligencia",
                  "expr": "10",
                  "quando": "talentos_h_corp_zodiaco",
                  "duracao": "temporaria",
                  "nome": "Zodíaco: Rato"
                },
                {
                  "canal": "limiteAtributo",
                  "alvo": "inteligencia",
                  "expr": "2 * (inteligencia >= 30)",
                  "furaTeto": true,
                  "quando": "talentos_h_corp_zodiaco",
                  "duracao": "temporaria",
                  "nome": "Zodíaco: Rato"
                },
                {
                  "canal": "atributo",
                  "alvo": "inteligencia",
